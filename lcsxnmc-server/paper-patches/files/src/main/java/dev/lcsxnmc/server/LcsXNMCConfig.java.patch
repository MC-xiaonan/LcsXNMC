+package dev.lcsxnmc.server;
+
+import dev.lcsxnmc.server.config.GlobalConfigManager;
+import dev.lcsxnmc.server.config.annotation.GlobalConfig;
+import dev.lcsxnmc.server.config.annotation.GlobalConfigCategory;
+import java.io.File;
+import java.io.IOException;
+import net.minecraft.server.MinecraftServer;
+import org.bukkit.configuration.file.YamlConfiguration;
+
+/**
+ * The root of LcsXNMC's own config file, {@code lcsxnmc.yml}. Fields annotated
+ * with {@link GlobalConfig} (directly, or via a {@link GlobalConfigCategory}
+ * nested field) are bound to the yaml document by {@link GlobalConfigManager}.
+ */
+public final class LcsXNMCConfig {
+
+    private static final String HEADER =
+        "This is the main configuration file for LcsXNMC.\n"
+            + "If you don't know what something does, don't change it, unless you know what you are doing.\n";
+
+    private LcsXNMCConfig() {
+    }
+
+    @GlobalConfig("config-version")
+    public static int configVersion = 1;
+
+    public static FeaturesCategory features = new FeaturesCategory();
+
+    @GlobalConfigCategory("features")
+    public static final class FeaturesCategory {
+        @GlobalConfig("debug-logging")
+        public boolean debugLogging = false;
+    }
+
+    private static File configFile;
+    private static YamlConfiguration config;
+
+    public static void init(File file) {
+        configFile = file;
+        reload();
+    }
+
+    public static void reload() {
+        config = YamlConfiguration.loadConfiguration(configFile);
+        config.options().header(HEADER);
+        GlobalConfigManager.load(config, LcsXNMCConfig.class);
+        save();
+    }
+
+    private static void save() {
+        try {
+            config.save(configFile);
+        } catch (IOException e) {
+            MinecraftServer.LOGGER.warn("Could not save {}", configFile, e);
+        }
+    }
+}
