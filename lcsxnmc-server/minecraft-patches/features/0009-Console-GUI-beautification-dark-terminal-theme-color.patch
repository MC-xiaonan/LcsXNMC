+    /**
+     * Heuristically picks a foreground color for a (already ANSI-stripped) log line based on
+     * its severity token or well-known join/leave phrasing, so the console reads like a
+     * modern colorized terminal instead of a flat wall of gray text.
+     */
+    private static java.awt.Color resolveLogColor(final String line) {
+        if (line.contains("/ERROR]") || line.contains(" ERROR]") || line.contains("/FATAL]") || line.contains("/SEVERE]")) {
+            return ERROR_COLOR;
+        } else if (line.contains("/WARN]") || line.contains(" WARN]")) {
+            return WARN_COLOR;
+        } else if (JOIN_PATTERN.matcher(line).find()) {
+            return JOIN_COLOR;
+        } else if (LEAVE_PATTERN.matcher(line).find()) {
+            return LEAVE_COLOR;
+        } else {
+            return TEXT_COLOR;
+        }
+    }
