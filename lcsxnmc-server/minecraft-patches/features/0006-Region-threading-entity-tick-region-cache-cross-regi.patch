diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/EntityLookup.java b/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/EntityLookup.java
index 328784ba08236553e49d62320b79f7222292412f..3782c58aa70021f6498f148b2d00ba9e372556bd 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/EntityLookup.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/EntityLookup.java
@@ -89,6 +89,23 @@ public abstract class EntityLookup implements LevelEntityGetter<Entity> {
 
     protected abstract boolean screenEntity(final Entity entity, final boolean fromDisk, final boolean event);
 
+    // LcsXNMC start - region threading: two-phase cross-region entity handoff
+    /**
+     * Whether moving to the given chunk section falls outside the region the calling thread
+     * currently owns, and therefore must go through the two-phase handoff protocol below
+     * instead of a synchronous slice swap.
+     */
+    protected abstract boolean isCrossRegionMove(final int newSectionX, final int newSectionZ);
+
+    /**
+     * Enqueues an entity that has already been removed from its old chunk section for pickup
+     * by the region that owns the given new chunk section. The entity becomes visible in its
+     * new section only once that region drains its arrival queue on its own thread, at the
+     * start of its next tick - never synchronously from the calling thread.
+     */
+    protected abstract void enqueueCrossRegionArrival(final Entity entity, final int newSectionX, final int newSectionY, final int newSectionZ);
+    // LcsXNMC end - region threading
+
     private static Entity maskNonAccessible(final Entity entity) {
         if (entity == null) {
             return null;
@@ -534,12 +551,37 @@ public abstract class EntityLookup implements LevelEntityGetter<Entity> {
             return null;
         }
 
-        // ensure the new section is owned by this tick thread
-        this.checkThread(newSectionX, newSectionZ, "Cannot move entity off-main");
-
         // ensure the old section is owned by this tick thread
         this.checkThread(sectionX, sectionZ, "Cannot move entity off-main");
 
+        // LcsXNMC start - region threading: two-phase cross-region handoff
+        if (this.isCrossRegionMove(newSectionX, newSectionZ)) {
+            final ChunkEntitySlices old = this.getChunk(sectionX, sectionZ);
+
+            if (!old.removeEntity(entity, sectionY)) {
+                LOGGER.warn("Could not remove entity " + entity + " from its old chunk section (" + sectionX + "," + sectionY + "," + sectionZ + ") since it was not contained in the section");
+            }
+
+            ((ChunkSystemEntity)entity).moonrise$setSectionX(newSectionX);
+            ((ChunkSystemEntity)entity).moonrise$setSectionY(newSectionY);
+            ((ChunkSystemEntity)entity).moonrise$setSectionZ(newSectionZ);
+
+            if (old.isEmpty()) {
+                this.onEmptySlices(sectionX, sectionZ);
+            }
+
+            // the calling thread does not own the destination chunk and must not touch its
+            // ChunkEntitySlices - addEntity + entitySectionChangeCallback happen on the target
+            // region's own thread when it drains its arrival queue
+            this.enqueueCrossRegionArrival(entity, newSectionX, newSectionY, newSectionZ);
+
+            return null;
+        }
+        // LcsXNMC end - region threading
+
+        // ensure the new section is owned by this tick thread
+        this.checkThread(newSectionX, newSectionZ, "Cannot move entity off-main");
+
         final ChunkEntitySlices old = this.getChunk(sectionX, sectionZ);
         final ChunkEntitySlices slices = this.getOrCreateChunk(newSectionX, newSectionZ);
 
