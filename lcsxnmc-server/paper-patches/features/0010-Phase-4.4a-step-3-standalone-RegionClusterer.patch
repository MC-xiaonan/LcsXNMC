@@ -0,0 +1,201 @@
+package dev.lcsxnmc.server.regionizer;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+
+/**
+ * Clusters online players into connected "regions" by chunk-distance
+ * union-find, then assigns each cluster a {@code regionId} - reusing an
+ * existing id when the new cluster's chunk set overlaps a previous region's
+ * chunk set enough (sticky ids, so a region's worker thread doesn't get torn
+ * down and rebuilt every reclustering tick just because a player nudged
+ * across a boundary).
+ * <p>
+ * Deliberately narrow: this only decides which players share a worker thread
+ * and which chunks that worker owns. It does not flood-fill through loaded
+ * chunks, does not know about worlds, threads, or entities, and does not
+ * compute the "global" region - the caller derives that separately as "every
+ * loaded chunk minus every returned region's chunks".
+ */
+public final class RegionClusterer {
+
+    public record PlayerAnchor(UUID playerId, int chunkX, int chunkZ) {
+    }
+
+    public record Region(long regionId, Set<UUID> members, Set<Long> chunks) {
+    }
+
+    @FunctionalInterface
+    public interface RegionIdAllocator {
+        long nextId();
+    }
+
+    private final int minRegionRadiusChunks;
+    private final int mergeDistanceChunks;
+    private final double stickyOverlapThreshold;
+
+    public RegionClusterer(final int minRegionRadiusChunks, final int mergeDistanceChunks, final double stickyOverlapThreshold) {
+        if (minRegionRadiusChunks < 0) {
+            throw new IllegalArgumentException("minRegionRadiusChunks must not be negative");
+        }
+        if (mergeDistanceChunks < 0) {
+            throw new IllegalArgumentException("mergeDistanceChunks must not be negative");
+        }
+        this.minRegionRadiusChunks = minRegionRadiusChunks;
+        this.mergeDistanceChunks = mergeDistanceChunks;
+        this.stickyOverlapThreshold = stickyOverlapThreshold;
+    }
+
+    public static long chunkKey(final int chunkX, final int chunkZ) {
+        return (chunkX & 0xFFFFFFFFL) | ((chunkZ & 0xFFFFFFFFL) << 32);
+    }
+
+    /**
+     * @param players         currently online players to cluster; order determines
+     *                        tie-breaking and (together with {@code idAllocator}) is what
+     *                        makes the result reproducible for the same inputs
+     * @param previousRegions the previous tick's regions, used only to decide which
+     *                        new cluster (if any) inherits which old region's id
+     * @param idAllocator     supplies a fresh id for every new cluster that doesn't
+     *                        inherit one
+     */
+    public List<Region> cluster(final List<PlayerAnchor> players, final List<Region> previousRegions, final RegionIdAllocator idAllocator) {
+        if (players.isEmpty()) {
+            return List.of();
+        }
+
+        final int mergeThreshold = 2 * this.minRegionRadiusChunks + this.mergeDistanceChunks;
+        final UnionFind unionFind = new UnionFind(players.size());
+        for (int i = 0; i < players.size(); i++) {
+            final PlayerAnchor a = players.get(i);
+            for (int j = i + 1; j < players.size(); j++) {
+                final PlayerAnchor b = players.get(j);
+                final int dx = Math.abs(a.chunkX() - b.chunkX());
+                final int dz = Math.abs(a.chunkZ() - b.chunkZ());
+                if (Math.max(dx, dz) <= mergeThreshold) {
+                    unionFind.union(i, j);
+                }
+            }
+        }
+
+        // LinkedHashMap: iteration order must follow first-seen player order so that
+        // cluster order (and therefore idAllocator.nextId() call order) is reproducible.
+        final Map<Integer, List<PlayerAnchor>> componentsByRoot = new LinkedHashMap<>();
+        for (int i = 0; i < players.size(); i++) {
+            componentsByRoot.computeIfAbsent(unionFind.find(i), root -> new ArrayList<>()).add(players.get(i));
+        }
+
+        final List<UnassignedCluster> clusters = new ArrayList<>(componentsByRoot.size());
+        for (final List<PlayerAnchor> members : componentsByRoot.values()) {
+            final Set<Long> chunks = new HashSet<>();
+            final Set<UUID> memberIds = new HashSet<>();
+            for (final PlayerAnchor anchor : members) {
+                memberIds.add(anchor.playerId());
+                for (int cx = anchor.chunkX() - this.minRegionRadiusChunks; cx <= anchor.chunkX() + this.minRegionRadiusChunks; cx++) {
+                    for (int cz = anchor.chunkZ() - this.minRegionRadiusChunks; cz <= anchor.chunkZ() + this.minRegionRadiusChunks; cz++) {
+                        chunks.add(chunkKey(cx, cz));
+                    }
+                }
+            }
+            clusters.add(new UnassignedCluster(memberIds, chunks));
+        }
+
+        return assignStickyIds(clusters, previousRegions, idAllocator);
+    }
+
+    private record UnassignedCluster(Set<UUID> members, Set<Long> chunks) {
+    }
+
+    private record Candidate(int clusterIndex, Region oldRegion, double overlap) {
+    }
+
+    private List<Region> assignStickyIds(final List<UnassignedCluster> clusters, final List<Region> previousRegions, final RegionIdAllocator idAllocator) {
+        final List<Candidate> candidates = new ArrayList<>();
+        for (int i = 0; i < clusters.size(); i++) {
+            final Set<Long> newChunks = clusters.get(i).chunks();
+            for (final Region old : previousRegions) {
+                if (old.chunks().isEmpty()) {
+                    continue;
+                }
+                int intersectionSize = 0;
+                for (final long chunk : old.chunks()) {
+                    if (newChunks.contains(chunk)) {
+                        intersectionSize++;
+                    }
+                }
+                final double overlap = (double) intersectionSize / old.chunks().size();
+                if (overlap >= this.stickyOverlapThreshold) {
+                    candidates.add(new Candidate(i, old, overlap));
+                }
+            }
+        }
+
+        // Highest overlap first; ties broken by the smaller old region id so a merge of two
+        // stale regions deterministically keeps the older/lower id rather than an arbitrary one.
+        candidates.sort((a, b) -> {
+            final int overlapCompare = Double.compare(b.overlap(), a.overlap());
+            if (overlapCompare != 0) {
+                return overlapCompare;
+            }
+            return Long.compare(a.oldRegion().regionId(), b.oldRegion().regionId());
+        });
+
+        final Long[] assignedId = new Long[clusters.size()];
+        final Set<Long> claimedOldRegionIds = new HashSet<>();
+        for (final Candidate candidate : candidates) {
+            if (assignedId[candidate.clusterIndex()] != null) {
+                continue; // this cluster already inherited an id from a higher-overlap match
+            }
+            if (!claimedOldRegionIds.add(candidate.oldRegion().regionId())) {
+                continue; // this old region's id was already claimed by a higher-overlap cluster
+            }
+            assignedId[candidate.clusterIndex()] = candidate.oldRegion().regionId();
+        }
+
+        final List<Region> result = new ArrayList<>(clusters.size());
+        for (int i = 0; i < clusters.size(); i++) {
+            final long regionId = assignedId[i] != null ? assignedId[i] : idAllocator.nextId();
+            final UnassignedCluster cluster = clusters.get(i);
+            result.add(new Region(regionId, Set.copyOf(cluster.members()), Set.copyOf(cluster.chunks())));
+        }
+        return result;
+    }
+
+    private static final class UnionFind {
+        private final int[] parent;
+
+        UnionFind(final int size) {
+            this.parent = new int[size];
+            for (int i = 0; i < size; i++) {
+                this.parent[i] = i;
+            }
+        }
+
+        int find(final int x) {
+            int root = x;
+            while (this.parent[root] != root) {
+                root = this.parent[root];
+            }
+            int current = x;
+            while (this.parent[current] != root) {
+                final int next = this.parent[current];
+                this.parent[current] = root;
+                current = next;
+            }
+            return root;
+        }
+
+        void union(final int a, final int b) {
+            final int rootA = find(a);
+            final int rootB = find(b);
+            if (rootA != rootB) {
+                this.parent[rootA] = rootB;
+            }
+        }
+    }
+}
diff --git a/src/test/java/dev/lcsxnmc/server/regionizer/RegionClustererTest.java b/src/test/java/dev/lcsxnmc/server/regionizer/RegionClustererTest.java
