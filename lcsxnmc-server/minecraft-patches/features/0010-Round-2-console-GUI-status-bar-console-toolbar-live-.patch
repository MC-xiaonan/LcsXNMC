+    /**
+     * Plain JTextField that paints a muted hint string whenever it is both empty and unfocused. The
+     * hint is a pure paint-time overlay drawn on top of the normal text rendering - it never touches
+     * the field's Document, so it cannot interfere with typed text, command submission, or the
+     * existing Up/Down command-history recall.
+     */
+    private static final class PlaceholderTextField extends JTextField {
+        private final String placeholder;
+
+        PlaceholderTextField(final String placeholder) {
+            super();
+            this.placeholder = placeholder;
+        }
+
+        @Override
+        protected void paintComponent(final java.awt.Graphics g) {
+            super.paintComponent(g);
+            if (this.getText().isEmpty() && !this.isFocusOwner()) {
+                java.awt.Graphics2D g2 = (java.awt.Graphics2D) g.create();
+                try {
+                    g2.setRenderingHint(java.awt.RenderingHints.KEY_ANTIALIASING, java.awt.RenderingHints.VALUE_ANTIALIAS_ON);
+                    g2.setColor(MUTED_TEXT_COLOR);
+                    g2.setFont(this.getFont());
+                    java.awt.FontMetrics metrics = g2.getFontMetrics();
+                    java.awt.Insets insets = this.getInsets();
+                    int x = insets.left;
+                    int y = (this.getHeight() - metrics.getHeight()) / 2 + metrics.getAscent();
+                    g2.drawString(this.placeholder, x, y);
+                } finally {
+                    g2.dispose();
+                }
+            }
+        }
+    }
 
