 package dev.lcsxnmc.api.plugin;
 
 import org.bukkit.Bukkit;
-import org.jetbrains.annotations.NotNull;
 
 /**
  * Static convenience accessors for {@link FeatureManager}, mirroring the
@@ -17,7 +16,6 @@ public final class Features {
      *
      * @return the feature manager
      */
-    @NotNull
     public static FeatureManager manager() {
         return Bukkit.getServer().getFeatureManager();
     }
@@ -28,7 +26,7 @@ public final class Features {
      * @param key the feature key
      * @return true if the feature is enabled
      */
-    public static boolean isEnabled(@NotNull String key) {
+    public static boolean isEnabled(String key) {
         return manager().isFeatureEnabled(key);
     }
-}
\ No newline at end of file
+}
