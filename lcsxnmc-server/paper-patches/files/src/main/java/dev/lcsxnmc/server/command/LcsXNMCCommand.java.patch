+package dev.lcsxnmc.server.command;
+
+import dev.lcsxnmc.server.LcsXNMCConfig;
+import java.util.List;
+import java.util.Locale;
+import net.minecraft.server.MinecraftServer;
+import org.bukkit.Bukkit;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.bukkit.permissions.Permission;
+import org.bukkit.permissions.PermissionDefault;
+
+/**
+ * The {@code /lcsxnmc} command: {@code version}, {@code features}, {@code reload}.
+ */
+public final class LcsXNMCCommand extends Command {
+
+    private static final String PERMISSION = "lcsxnmc.command";
+    private static final List<String> SUBCOMMANDS = List.of("version", "features", "reload");
+
+    public LcsXNMCCommand(final String name) {
+        super(name);
+        this.description = "LcsXNMC related commands";
+        this.usageMessage = "/lcsxnmc [" + String.join(" | ", SUBCOMMANDS) + "]";
+        this.setPermission(PERMISSION);
+        Bukkit.getServer().getPluginManager().addPermission(new Permission(PERMISSION, PermissionDefault.OP));
+    }
+
+    @Override
+    public boolean execute(final CommandSender sender, final String commandLabel, final String[] args) {
+        if (!this.testPermission(sender)) {
+            return true;
+        }
+
+        final String sub = args.length == 0 ? "version" : args[0].toLowerCase(Locale.ROOT);
+        switch (sub) {
+            case "version" -> sender.sendMessage("This server is running " + Bukkit.getServer().getFeatureManager().getLcsXNMCVersion());
+            case "features" -> this.sendFeatures(sender);
+            case "reload" -> {
+                LcsXNMCConfig.reload();
+                sender.sendMessage("LcsXNMC configuration reloaded.");
+            }
+            default -> {
+                sender.sendMessage("Usage: " + this.usageMessage);
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private void sendFeatures(final CommandSender sender) {
+        final var featureManager = Bukkit.getServer().getFeatureManager();
+        for (final String key : featureManager.getKnownFeatures()) {
+            final boolean enabled = featureManager.isFeatureEnabled(key);
+            sender.sendMessage((enabled ? "+ " : "- ") + key);
+        }
+    }
+
+    @Override
+    public List<String> tabComplete(final CommandSender sender, final String alias, final String[] args) {
+        if (args.length <= 1) {
+            final String prefix = args.length == 0 ? "" : args[0].toLowerCase(Locale.ROOT);
+            return SUBCOMMANDS.stream().filter(s -> s.startsWith(prefix)).toList();
+        }
+        return List.of();
+    }
+
+    public static void register(final MinecraftServer server) {
+        server.server.getCommandMap().register("lcsxnmc", "LcsXNMC", new LcsXNMCCommand("lcsxnmc"));
+    }
+}
