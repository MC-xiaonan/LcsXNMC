Subject: [PATCH] Phase 4.4a step 6 prep (Task #14): extract
 ServerLevel.tickSingleThreaded, add dead tickRegionized branch


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index c29ace6a331e413db20a683dd6df591a91e8a88c..b1341de8eebefccc2ebab813a0ac3d787168b1ca 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -801,7 +801,27 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         return previous;
     }
 
+    // LcsXNMC start - region threading: Phase 4.4a step 6 prep (Task #14). tick(haveTime) is now a thin
+    // dispatcher; tickSingleThreaded(haveTime) is today's tick logic moved verbatim (no behavior change -
+    // diff against the old tick() body is a pure rename). tickRegionized(haveTime) is a placeholder for the
+    // real region-parallel tick loop and is unreachable while region-threading.enabled stays false (the
+    // only value shipped so far), so this refactor is a zero-behavior-change step.
     public void tick(final BooleanSupplier haveTime) {
+        if (dev.lcsxnmc.server.LcsXNMCConfig.regionThreading.enabled) {
+            this.tickRegionized(haveTime);
+        } else {
+            this.tickSingleThreaded(haveTime);
+        }
+    }
+
+    private void tickRegionized(final BooleanSupplier haveTime) {
+        // Phase 4.4a step 6 (Task #14): real region-parallel ServerLevel.tick() integration is not
+        // implemented yet. This branch is unreachable today because region-threading.enabled defaults to
+        // false and nothing flips it to true in production.
+        throw new UnsupportedOperationException("region-threading.enabled=true is not supported yet (Phase 4.4a step 6 is not implemented)");
+    }
+
+    private void tickSingleThreaded(final BooleanSupplier haveTime) {
         ProfilerFiller profiler = Profiler.get();
         this.handlingTick = true;
         this.environmentAttributes().invalidateTickCache();
