      */
-    @NotNull
-    String getLcsXNMCVersion();
+    String getLcsXnmcVersion();
 
     /**
      * Registers a "repair plugin" capability descriptor. Idempotent: registering
@@ -52,7 +48,7 @@ public interface FeatureManager {
      *
      * @param provider the provider to register
      */
-    void registerProvider(@NotNull LegacyBehaviorProvider provider);
+    void registerProvider(LegacyBehaviorProvider provider);
 
     /**
      * Unregisters a previously-registered provider. Does nothing if it was
@@ -60,13 +56,12 @@ public interface FeatureManager {
      *
      * @param provider the provider to unregister
      */
-    void unregisterProvider(@NotNull LegacyBehaviorProvider provider);
+    void unregisterProvider(LegacyBehaviorProvider provider);
 
     /**
      * Gets every currently-registered {@link LegacyBehaviorProvider}.
      *
      * @return an immutable view of the registered providers
      */
-    @NotNull
     Set<LegacyBehaviorProvider> getRegisteredProviders();
-}
\ No newline at end of file
+}
diff --git a/src/main/java/dev/lcsxnmc/api/plugin/Features.java b/src/main/java/dev/lcsxnmc/api/plugin/Features.java
