diff --git a/src/test/java/dev/lcsxnmc/server/config/GlobalConfigManagerTest.java b/src/test/java/dev/lcsxnmc/server/config/GlobalConfigManagerTest.java
index d876cba502b82a61c742139080fa9fef40bb1c6a..f10b464f3a31123ffa950c0ebf1c0346507f9d0e 100644
--- a/src/test/java/dev/lcsxnmc/server/config/GlobalConfigManagerTest.java
+++ b/src/test/java/dev/lcsxnmc/server/config/GlobalConfigManagerTest.java
@@ -91,4 +91,31 @@ public class GlobalConfigManagerTest {
         assertTrue(SampleConfig.features.debugLogging);
         assertEquals(8, SampleConfig.features.workerThreads);
     }
+
+    // Deliberately not @GlobalConfigCategory-annotated: bindInstance() takes an
+    // explicit path prefix from the caller instead of relying on annotation-driven
+    // category detection, since a plugin-supplied section isn't reachable from
+    // LcsXNMCConfig's own static field tree.
+    public static final class SampleInstanceSection {
+        @GlobalConfig("enabled")
+        public boolean enabled = true;
+
+        @GlobalConfig("threshold")
+        public int threshold = 5;
+    }
+
+    @Test
+    public void bindInstanceBindsAPlainObjectUnderAPathPrefixLikeAPluginProvidedConfigSection() {
+        YamlConfiguration yaml = new YamlConfiguration();
+        SampleInstanceSection section = new SampleInstanceSection();
+
+        GlobalConfigManager.bindInstance(yaml, section, "legacy-providers.acme.");
+
+        assertTrue(yaml.getBoolean("legacy-providers.acme.enabled"));
+        assertEquals(5, yaml.getInt("legacy-providers.acme.threshold"));
+
+        yaml.set("legacy-providers.acme.threshold", 9);
+        GlobalConfigManager.bindInstance(yaml, section, "legacy-providers.acme.");
+        assertEquals(9, section.threshold);
+    }
 }
