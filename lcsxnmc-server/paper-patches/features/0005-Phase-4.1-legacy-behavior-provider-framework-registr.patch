+    private void sendLegacyProviders(final CommandSender sender) {
+        final var providers = Bukkit.getServer().getFeatureManager().getRegisteredProviders();
+        if (providers.isEmpty()) {
+            sender.sendMessage("No legacy behavior providers are registered.");
+            return;
+        }
+        for (final var provider : providers) {
+            sender.sendMessage(provider.getId() + " - " + provider.getDescription()
+                + " [" + String.join(", ", provider.getSupportedKeys()) + "]");
+        }
+    }
+
