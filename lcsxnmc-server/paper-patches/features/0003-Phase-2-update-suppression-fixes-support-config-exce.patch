index 7b2b49ac8933277c032d2a0ff3e5743300940221..5cabb3c66c56c55d4b3c01ac0197a0d33f3d83f2 100644
--- a/src/main/java/dev/lcsxnmc/server/LcsXNMCConfig.java
+++ b/src/main/java/dev/lcsxnmc/server/LcsXNMCConfig.java
@@ -33,6 +33,79 @@ public final class LcsXNMCConfig {
         public boolean debugLogging = false;
     }
 
