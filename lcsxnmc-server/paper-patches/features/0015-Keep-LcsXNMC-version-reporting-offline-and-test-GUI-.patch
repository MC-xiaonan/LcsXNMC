+package dev.lcsxnmc;
+
+import com.destroystokyo.paper.PaperVersionFetcher;
+import com.destroystokyo.paper.VersionHistoryManager;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.event.ClickEvent;
+import net.kyori.adventure.text.serializer.plain.PlainTextComponentSerializer;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+@Normal
+class LcsXnmcVersionFetcherTest {
+
+    @Test
+    void reportsOfflineStatusWithProjectLink() {
+        final Component message = new PaperVersionFetcher().getVersionMessage();
+        final String text = PlainTextComponentSerializer.plainText().serialize(message);
+        assertTrue(text.contains("Automatic update checking is disabled for LcsXNMC."));
+        assertTrue(text.contains("https://github.com/MC-xiaonan/LcsXNMC/releases"));
+        assertFalse(text.contains("papermc.io"));
+        assertFalse(text.contains("latest version"));
+        assertFalse(text.contains("Unknown version"));
+        assertTrue(hasReleaseLink(message));
+    }
+
+    @Test
+    void retainsLocalVersionHistory() {
+        final VersionHistoryManager.VersionData data = VersionHistoryManager.INSTANCE.getVersionData();
+        assertNotNull(data);
+        final String previous = data.getOldVersion();
+        try {
+            data.setOldVersion("LcsXNMC-test-previous");
+            final String text = PlainTextComponentSerializer.plainText().serialize(new PaperVersionFetcher().getVersionMessage());
+            assertTrue(text.contains("Previous version: LcsXNMC-test-previous"));
+        } finally {
+            data.setOldVersion(previous);
+        }
+    }
+
+    @Test
+    void omitsHistoryWhenThereIsNoPreviousVersion() {
+        final VersionHistoryManager.VersionData data = VersionHistoryManager.INSTANCE.getVersionData();
+        assertNotNull(data);
+        final String previous = data.getOldVersion();
+        try {
+            data.setOldVersion(null);
+            final String text = PlainTextComponentSerializer.plainText().serialize(new PaperVersionFetcher().getVersionMessage());
+            assertFalse(text.contains("Previous version:"));
+        } finally {
+            data.setOldVersion(previous);
+        }
+    }
+
+    private static boolean hasReleaseLink(final Component component) {
+        if (ClickEvent.openUrl("https://github.com/MC-xiaonan/LcsXNMC/releases").equals(component.clickEvent())) {
+            return true;
+        }
+        return component.children().stream().anyMatch(LcsXnmcVersionFetcherTest::hasReleaseLink);
+    }
+}
