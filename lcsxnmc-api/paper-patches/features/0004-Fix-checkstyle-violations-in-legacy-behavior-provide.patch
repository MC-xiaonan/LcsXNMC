 /**
  * A self-declared "repair plugin" capability descriptor: a statement of which
@@ -25,7 +24,6 @@ public interface LegacyBehaviorProvider {
      *
      * @return the provider id
      */
-    @NotNull
     String getId();
 
     /**
@@ -33,7 +31,6 @@ public interface LegacyBehaviorProvider {
      *
      * @return the description
      */
-    @NotNull
     String getDescription();
 
     /**
@@ -41,7 +38,6 @@ public interface LegacyBehaviorProvider {
      *
      * @return an immutable set of supported behavior keys
      */
-    @NotNull
     Set<String> getSupportedKeys();
 
     /**
@@ -53,8 +49,7 @@ public interface LegacyBehaviorProvider {
      *
      * @return the config section instance, or null
      */
-    @Nullable
-    default Object getConfigSection() {
+    default @Nullable Object getConfigSection() {
         return null;
     }
 }
diff --git a/src/main/java/dev/lcsxnmc/api/legacy/package-info.java b/src/main/java/dev/lcsxnmc/api/legacy/package-info.java
