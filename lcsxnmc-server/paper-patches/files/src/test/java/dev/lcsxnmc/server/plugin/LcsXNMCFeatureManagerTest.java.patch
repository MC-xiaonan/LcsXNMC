+package dev.lcsxnmc.server.plugin;
+
+import dev.lcsxnmc.api.legacy.LegacyBehaviorEvent;
+import dev.lcsxnmc.api.legacy.LegacyBehaviorProvider;
+import io.papermc.paper.plugin.PaperTestPlugin;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import org.bukkit.Bukkit;
+import org.bukkit.event.EventHandler;
+import org.bukkit.event.Listener;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+@Normal
+public class LcsXNMCFeatureManagerTest {
+
+    private final LcsXNMCFeatureManager featureManager = new LcsXNMCFeatureManager();
+
+    @AfterEach
+    public void tearDown() {
+        Bukkit.getPluginManager().clearPlugins();
+    }
+
+    private static LegacyBehaviorProvider provider(final String id, final String... keys) {
+        return new LegacyBehaviorProvider() {
+            @Override
+            public String getId() {
+                return id;
+            }
+
+            @Override
+            public String getDescription() {
+                return "test provider " + id;
+            }
+
+            @Override
+            public Set<String> getSupportedKeys() {
+                return Set.of(keys);
+            }
+        };
+    }
+
+    @Test
+    public void registerProviderMakesItDiscoverable() {
+        final LegacyBehaviorProvider provider = provider("test-provider", "some.key");
+
+        this.featureManager.registerProvider(provider);
+
+        assertEquals(Set.of(provider), this.featureManager.getRegisteredProviders());
+    }
+
+    @Test
+    public void unregisterProviderRemovesIt() {
+        final LegacyBehaviorProvider provider = provider("test-provider", "some.key");
+        this.featureManager.registerProvider(provider);
+
+        this.featureManager.unregisterProvider(provider);
+
+        assertTrue(this.featureManager.getRegisteredProviders().isEmpty());
+    }
+
+    @Test
+    public void registeringTheSameProviderTwiceDoesNotDuplicateIt() {
+        final LegacyBehaviorProvider provider = provider("test-provider", "some.key");
+
+        this.featureManager.registerProvider(provider);
+        this.featureManager.registerProvider(provider);
+
+        assertEquals(1, this.featureManager.getRegisteredProviders().size());
+    }
+
+    @Test
+    public void registeredProvidersSetIsUnmodifiable() {
+        this.featureManager.registerProvider(provider("test-provider", "some.key"));
+
+        assertThrows(UnsupportedOperationException.class, () -> this.featureManager.getRegisteredProviders().clear());
+    }
+
+    @Test
+    public void unregisteringAnUnknownProviderIsANoOp() {
+        this.featureManager.unregisterProvider(provider("never-registered"));
+
+        assertTrue(this.featureManager.getRegisteredProviders().isEmpty());
+    }
+
+    @Test
+    public void fireDispatchesThroughTheNormalBukkitEventBusAndSupportsCancellation() {
+        final PaperTestPlugin plugin = new PaperTestPlugin("legacytest");
+        final List<String> observedKeys = new ArrayList<>();
+        final Listener listener = new Listener() {
+            @EventHandler
+            public void onLegacyBehavior(final LegacyBehaviorEvent event) {
+                observedKeys.add(event.getKey());
+                if (event.getKey().equals("restore.me")) {
+                    event.setCancelled(true);
+                }
+            }
+        };
+        Bukkit.getPluginManager().registerEvents(listener, plugin);
+
+        final LegacyBehaviorEvent restored = LegacyBehaviorSupport.fire("restore.me", Map.of("foo", "bar"));
+        final LegacyBehaviorEvent notRestored = LegacyBehaviorSupport.fire("leave.alone", Map.of());
+
+        assertTrue(restored.isCancelled());
+        assertFalse(notRestored.isCancelled());
+        assertEquals(List.of("restore.me", "leave.alone"), observedKeys);
+        assertEquals("bar", restored.getContext("foo"));
+    }
+
+    @Test
+    public void firingWithNoListenersLeavesTheEventUncancelled() {
+        final LegacyBehaviorEvent event = LegacyBehaviorSupport.fire("nobody.listens", Map.of());
+
+        assertFalse(event.isCancelled());
+    }
+}
