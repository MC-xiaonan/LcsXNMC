+package dev.lcsxnmc.server.config.annotation;
+
+import java.lang.annotation.ElementType;
+import java.lang.annotation.Retention;
+import java.lang.annotation.RetentionPolicy;
+import java.lang.annotation.Target;
+
+/**
+ * Marks a type as a nested config category. A field whose type carries this
+ * annotation is recursed into by {@link GlobalConfigManager}, with the
+ * category's {@link #value()} prepended to the path of every
+ * {@link GlobalConfig} field it contains.
+ *
+ * @see GlobalConfig
+ * @see GlobalConfigManager
+ */
+@Target(ElementType.TYPE)
+@Retention(RetentionPolicy.RUNTIME)
+public @interface GlobalConfigCategory {
+
+    /**
+     * The config path segment for this category, relative to its enclosing
+     * category (or the config root if not nested).
+     */
+    String value();
+}
