@@ -1,6 +1,7 @@
 package ca.spottedleaf.moonrise.common.util;
 
 import net.minecraft.core.BlockPos;
+import net.minecraft.util.Mth;
 import net.minecraft.world.entity.Entity;
 import net.minecraft.world.level.ChunkPos;
 import net.minecraft.world.level.Level;
@@ -159,46 +160,130 @@ public class TickThread extends Thread {
     }
 
     public static boolean isTickThreadFor(final Level world, final BlockPos pos) {
-        return isTickThread();
+        return isTickThreadFor(world, pos.getX() >> 4, pos.getZ() >> 4);
     }
 
     public static boolean isTickThreadFor(final Level world, final BlockPos pos, final int blockRadius) {
-        return isTickThread();
+        return isTickThreadForBlockRange(
+            world, pos.getX() - blockRadius, pos.getZ() - blockRadius, pos.getX() + blockRadius, pos.getZ() + blockRadius
+        );
     }
 
     public static boolean isTickThreadFor(final Level world, final ChunkPos pos) {
-        return isTickThread();
+        return isTickThreadFor(world, pos.x(), pos.z());
     }
 
     public static boolean isTickThreadFor(final Level world, final Vec3 pos) {
-        return isTickThread();
+        return isTickThreadFor(world, Mth.floor(pos.x) >> 4, Mth.floor(pos.z) >> 4);
     }
 
     public static boolean isTickThreadFor(final Level world, final int chunkX, final int chunkZ) {
-        return isTickThread();
+        return isTickThreadForChunkRange(world, chunkX, chunkZ, chunkX, chunkZ);
     }
 
     public static boolean isTickThreadFor(final Level world, final AABB aabb) {
-        return isTickThread();
+        return isTickThreadForBlockRange(
+            world, Mth.floor(aabb.minX), Mth.floor(aabb.minZ), Mth.floor(aabb.maxX), Mth.floor(aabb.maxZ)
+        );
     }
 
     public static boolean isTickThreadFor(final Level world, final double blockX, final double blockZ) {
-        return isTickThread();
+        return isTickThreadFor(world, Mth.floor(blockX) >> 4, Mth.floor(blockZ) >> 4);
     }
 
     public static boolean isTickThreadFor(final Level world, final Vec3 position, final Vec3 deltaMovement, final int buffer) {
-        return isTickThread();
+        final Vec3 to = position.add(deltaMovement);
+        final double minX = Math.min(position.x, to.x) - buffer;
+        final double minZ = Math.min(position.z, to.z) - buffer;
+        final double maxX = Math.max(position.x, to.x) + buffer;
+        final double maxZ = Math.max(position.z, to.z) + buffer;
+        return isTickThreadForBlockRange(world, Mth.floor(minX), Mth.floor(minZ), Mth.floor(maxX), Mth.floor(maxZ));
     }
 
     public static boolean isTickThreadFor(final Level world, final int fromChunkX, final int fromChunkZ, final int toChunkX, final int toChunkZ) {
-        return isTickThread();
+        return isTickThreadForChunkRange(
+            world, Math.min(fromChunkX, toChunkX), Math.min(fromChunkZ, toChunkZ), Math.max(fromChunkX, toChunkX), Math.max(fromChunkZ, toChunkZ)
+        );
     }
 
     public static boolean isTickThreadFor(final Level world, final int chunkX, final int chunkZ, final int radius) {
-        return isTickThread();
+        return isTickThreadForChunkRange(world, chunkX - radius, chunkZ - radius, chunkX + radius, chunkZ + radius);
     }
 
     public static boolean isTickThreadFor(final Entity entity) {
-        return isTickThread();
+        return isTickThreadForRegion(((ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity)entity).moonrise$getTickRegion());
     }
+
+    /**
+     * Split out of {@link #isTickThreadFor(Entity)} so the entity-cache-snapshot logic can be
+     * unit tested directly against a bare {@link TickRegion}, without constructing a real
+     * {@link Entity} (which needs a running server). Consults only the given cached snapshot -
+     * never recomputes ownership from the entity's current position - so the result stays
+     * consistent with whatever the two-phase handoff protocol last wrote to it, even if the
+     * caller is mid-handoff on another region.
+     */
+    public static boolean isTickThreadForRegion(final TickRegion entityRegion) {
+        final Thread current = Thread.currentThread();
+        if (current instanceof RegionWorkerThread worker) {
+            final TickRegion workerRegion = worker.getCurrentRegion();
+            return workerRegion != null && workerRegion == entityRegion;
+        }
+        if (isGlobalTickThread(current)) {
+            // the entity's cached region snapshot is null ("global region") unless it has been
+            // claimed by a real TickRegion - which never happens yet, see TickRegion's javadoc
+            return entityRegion == null;
+        }
+        return false;
+    }
+
+    // LcsXNMC start - region threading: shared range-check helpers
+    private static boolean isTickThreadForBlockRange(final Level world, final int minBlockX, final int minBlockZ, final int maxBlockX, final int maxBlockZ) {
+        return isTickThreadForChunkRange(world, minBlockX >> 4, minBlockZ >> 4, maxBlockX >> 4, maxBlockZ >> 4);
+    }
+
+    /**
+     * Checks that the current thread owns every chunk in the given (inclusive) chunk range,
+     * not just the range's center - a partial range check would silently allow an operation
+     * to overrun a region boundary.
+     */
+    private static boolean isTickThreadForChunkRange(final Level world, final int minChunkX, final int minChunkZ, final int maxChunkX, final int maxChunkZ) {
+        final Thread current = Thread.currentThread();
+        if (current instanceof RegionWorkerThread worker) {
+            final TickRegion region = worker.getCurrentRegion();
+            if (region == null || region.getWorld() != world) {
+                return false;
+            }
+            for (int chunkZ = minChunkZ; chunkZ <= maxChunkZ; ++chunkZ) {
+                for (int chunkX = minChunkX; chunkX <= maxChunkX; ++chunkX) {
+                    if (!region.ownsChunk(chunkX, chunkZ)) {
+                        return false;
+                    }
+                }
+            }
+            return true;
+        }
+        if (isGlobalTickThread(current)) {
+            for (int chunkZ = minChunkZ; chunkZ <= maxChunkZ; ++chunkZ) {
+                for (int chunkX = minChunkX; chunkX <= maxChunkX; ++chunkX) {
+                    if (isClaimedByRealRegion(world, chunkX, chunkZ)) {
+                        return false;
+                    }
+                }
+            }
+            return true;
+        }
+        return false;
+    }
+
+    /**
+     * Whether the given chunk is currently owned by a real {@link TickRegion}. Hardcoded to
+     * {@code false} for the whole of Phase 4.4a step 4: nothing ever assigns a chunk to a
+     * region yet - that is {@code RegionizedWorldData}, landing in step 6. Until then every
+     * chunk in every world is, by definition, unclaimed, so the global tick thread owns
+     * everything, exactly as {@link #isTickThread()} always resolved before this method existed.
+     */
+    private static boolean isClaimedByRealRegion(final Level world, final int chunkX, final int chunkZ) {
+        return false;
+    }
+    // LcsXNMC end - region threading
 }
diff --git a/src/test/java/ca/spottedleaf/moonrise/common/util/TickThreadRegionTest.java b/src/test/java/ca/spottedleaf/moonrise/common/util/TickThreadRegionTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..abd72e3d11638ba45c61a17709c64501b2fe39e0
--- /dev/null
+++ b/src/test/java/ca/spottedleaf/moonrise/common/util/TickThreadRegionTest.java
@@ -0,0 +1,194 @@
+package ca.spottedleaf.moonrise.common.util;
+
+import it.unimi.dsi.fastutil.longs.LongOpenHashSet;
+import net.minecraft.world.level.Level;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+import org.mockito.Mockito;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Truth-table coverage for the real (non-stub) {@link TickThread#isTickThreadFor} logic and its
+ * {@link RegionWorkerThread}/{@link TickRegion} building blocks, per Phase 4.4a step 4.
+ * {@code region-threading.enabled} stays false in production for this whole step - nothing here
+ * exercises a running server, only directly-constructed threads and regions, exactly as the plan
+ * calls for ("不需要真实 ServerLevel 启动").
+ */
+@Normal
+public class TickThreadRegionTest {
+
+    private static TickRegion regionOf(final long id, final Level world, final long... chunkKeys) {
+        final LongOpenHashSet chunks = new LongOpenHashSet(chunkKeys);
+        return new TickRegion(id, world, chunks);
+    }
+
+    private static void runAndPropagate(final Thread thread) throws InterruptedException {
+        thread.start();
+        thread.join();
+    }
+
+    private interface ThrowingRunnable {
+        void run() throws Throwable;
+    }
+
+    private static Runnable capturing(final ThrowingRunnable body, final Throwable[] failureHolder) {
+        return () -> {
+            try {
+                body.run();
+            } catch (final Throwable t) {
+                failureHolder[0] = t;
+            }
+        };
+    }
+
+    private static void assertNoFailure(final Throwable[] failureHolder) {
+        if (failureHolder[0] != null) {
+            throw new AssertionError(failureHolder[0]);
+        }
+    }
+
+    @Test
+    public void mainThreadOwnsGlobalRegionChunks() throws InterruptedException {
+        final Throwable[] failure = new Throwable[1];
+        final Thread thread = new TickThread(capturing(() -> {
+            // no real region has ever been created, so the global tick thread owns every chunk
+            assertTrue(TickThread.isTickThreadFor((Level) null, 0, 0));
+            assertTrue(TickThread.isTickThreadFor((Level) null, -500, 999));
+            assertTrue(TickThread.isGlobalTickThread());
+        }, failure), "test-global-thread");
+
+        runAndPropagate(thread);
+        assertNoFailure(failure);
+    }
+
+    @Test
+    public void regionWorkerDoesNotOwnAnotherRegionsChunks() throws InterruptedException {
+        final Throwable[] failure = new Throwable[1];
+        final TickRegion region = regionOf(1L, null, CoordinateUtils.getChunkKey(0, 0), CoordinateUtils.getChunkKey(1, 0));
+        final RegionWorkerThread[] workerHolder = new RegionWorkerThread[1];
+
+        final RegionWorkerThread worker = new RegionWorkerThread(null, capturing(() -> {
+            workerHolder[0].setCurrentRegion(region);
+
+            assertTrue(TickThread.isTickThreadFor((Level) null, 0, 0));
+            assertTrue(TickThread.isTickThreadFor((Level) null, 1, 0));
+            // not in this region's owned set
+            assertFalse(TickThread.isTickThreadFor((Level) null, 5, 5));
+            // never the global thread
+            assertFalse(TickThread.isGlobalTickThread());
+        }, failure), null, 1L);
+        workerHolder[0] = worker;
+
+        runAndPropagate(worker);
+        assertNoFailure(failure);
+    }
+
+    @Test
+    public void regionWorkerChunkCheckFailsAcrossDifferentWorlds() throws InterruptedException {
+        final Level worldA = fakeLevel();
+        final Level worldB = fakeLevel();
+        final Throwable[] failure = new Throwable[1];
+        final TickRegion region = regionOf(2L, worldA, CoordinateUtils.getChunkKey(0, 0));
+        final RegionWorkerThread[] workerHolder = new RegionWorkerThread[1];
+
+        final RegionWorkerThread worker = new RegionWorkerThread(null, capturing(() -> {
+            workerHolder[0].setCurrentRegion(region);
+
+            assertTrue(TickThread.isTickThreadFor(worldA, 0, 0));
+            assertFalse(TickThread.isTickThreadFor(worldB, 0, 0));
+        }, failure), worldA, 2L);
+        workerHolder[0] = worker;
+
+        runAndPropagate(worker);
+        assertNoFailure(failure);
+    }
+
+    @Test
+    public void radiusCheckFailsIfAnySingleChunkInRadiusIsUnowned() throws InterruptedException {
+        final Throwable[] failure = new Throwable[1];
+        // owns the full 3x3 square around (0,0) except (1,1) - a naive center-only check would
+        // still see the center chunk as owned and wrongly report ownership of the whole radius
+        final LongOpenHashSet owned = new LongOpenHashSet();
+        for (int x = -1; x <= 1; x++) {
+            for (int z = -1; z <= 1; z++) {
+                if (x == 1 && z == 1) {
+                    continue;
+                }
+                owned.add(CoordinateUtils.getChunkKey(x, z));
+            }
+        }
+        final TickRegion region = new TickRegion(3L, null, owned);
+        final RegionWorkerThread[] workerHolder = new RegionWorkerThread[1];
+
+        final RegionWorkerThread worker = new RegionWorkerThread(null, capturing(() -> {
+            workerHolder[0].setCurrentRegion(region);
+
+            // center chunk alone is owned...
+            assertTrue(TickThread.isTickThreadFor((Level) null, 0, 0));
+            // ...but the full radius is not, because (1,1) is missing
+            assertFalse(TickThread.isTickThreadFor((Level) null, 0, 0, 1));
+            // same for the equivalent fromChunk/toChunk range overload
+            assertFalse(TickThread.isTickThreadFor((Level) null, -1, -1, 1, 1));
+            // a range that excludes the missing chunk still succeeds
+            assertTrue(TickThread.isTickThreadFor((Level) null, -1, -1, 0, 0));
+        }, failure), null, 3L);
+        workerHolder[0] = worker;
+
+        runAndPropagate(worker);
+        assertNoFailure(failure);
+    }
+
+    @Test
+    public void globalThreadRadiusCheckIsNeverClaimedByARealRegionYet() throws InterruptedException {
+        final Throwable[] failure = new Throwable[1];
+        final Thread thread = new TickThread(capturing(() -> {
+            // isClaimedByRealRegion() is hardcoded false for the whole of step 4, so every
+            // radius/AABB range still resolves true on the global thread, same as the old stub
+            assertTrue(TickThread.isTickThreadFor((Level) null, 0, 0, 50));
+        }, failure), "test-global-thread-radius");
+
+        runAndPropagate(thread);
+        assertNoFailure(failure);
+    }
+
+    @Test
+    public void entityOverloadUsesCachedRegionSnapshotNotLiveRecompute() throws InterruptedException {
+        final Throwable[] failure = new Throwable[1];
+        final TickRegion regionA = regionOf(4L, null, CoordinateUtils.getChunkKey(0, 0));
+        // regionB owns the exact same chunks as regionA - if the check were a live recompute of
+        // "does my worker's owned-chunk-set match", it would wrongly treat A and B as
+        // interchangeable; the cached-snapshot check must instead be a strict identity match
+        final TickRegion regionB = regionOf(5L, null, CoordinateUtils.getChunkKey(0, 0));
+        final RegionWorkerThread[] workerHolder = new RegionWorkerThread[1];
+
+        final RegionWorkerThread worker = new RegionWorkerThread(null, capturing(() -> {
+            workerHolder[0].setCurrentRegion(regionA);
+
+            assertTrue(TickThread.isTickThreadForRegion(regionA));
+            assertFalse(TickThread.isTickThreadForRegion(regionB));
+            assertFalse(TickThread.isTickThreadForRegion(null));
+        }, failure), null, 4L);
+        workerHolder[0] = worker;
+
+        runAndPropagate(worker);
+        assertNoFailure(failure);
+
+        final Throwable[] globalFailure = new Throwable[1];
+        final Thread globalThread = new TickThread(capturing(() -> {
+            // on the global thread, only the null ("global region") snapshot matches
+            assertTrue(TickThread.isTickThreadForRegion(null));
+            assertFalse(TickThread.isTickThreadForRegion(regionA));
+        }, globalFailure), "test-global-thread-entity");
+
+        runAndPropagate(globalThread);
+        assertNoFailure(globalFailure);
+    }
+
+    private static Level fakeLevel() {
+        // identity is all that matters here - isTickThreadFor only ever compares world
+        // references with ==, it never dereferences the Level itself for these checks
+        return Mockito.mock(Level.class);
+    }
+}
