      */
-    boolean isFeatureEnabled(@NotNull String key);
+    boolean isFeatureEnabled(String key);
 
     /**
      * Gets the keys of every feature LcsXNMC knows about, regardless of whether
@@ -27,7 +26,6 @@ public interface FeatureManager {
      *
