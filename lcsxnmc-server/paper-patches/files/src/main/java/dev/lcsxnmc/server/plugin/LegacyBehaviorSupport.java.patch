+package dev.lcsxnmc.server.plugin;
+
+import dev.lcsxnmc.api.legacy.LegacyBehaviorEvent;
+import java.util.Map;
+import org.bukkit.Bukkit;
+import org.jetbrains.annotations.NotNull;
+
+/**
+ * Engine-side helper for firing {@link LegacyBehaviorEvent}. Future patches
+ * that reintroduce a specific removed/changed vanilla behavior call
+ * {@link #fire(String, Map)} at the point in question and gate the actual
+ * behavior change on the returned event's {@code isCancelled()}, mirroring
+ * the {@code // Paper start - Restore ...} idiom already used throughout this
+ * project.
+ * <p>
+ * No concrete behavior keys are wired in yet: this class is the generic
+ * mechanism the "26.2 removed features" repair-plugin story depends on, not
+ * a specific restoration. Mount points get added here (via new call sites,
+ * not new methods) as concrete removed behaviors are identified.
+ */
+public final class LegacyBehaviorSupport {
+
+    private LegacyBehaviorSupport() {
+    }
+
+    @NotNull
+    public static LegacyBehaviorEvent fire(@NotNull String key, @NotNull Map<String, Object> context) {
+        LegacyBehaviorEvent event = new LegacyBehaviorEvent(key, context);
+        Bukkit.getPluginManager().callEvent(event);
+        return event;
+    }
+}
