index 0000000000000000000000000000000000000000..895ae863e393d2e4de6697e1040191d1257977b7
--- /dev/null
+++ b/src/test/java/dev/lcsxnmc/server/regionizer/RegionClustererTest.java
@@ -0,0 +1,213 @@
+package dev.lcsxnmc.server.regionizer;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicLong;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+@Normal
+public class RegionClustererTest {
+
+    private static final UUID PLAYER_A = UUID.fromString("00000000-0000-0000-0000-00000000000a");
+    private static final UUID PLAYER_B = UUID.fromString("00000000-0000-0000-0000-00000000000b");
+
+    private static RegionClusterer.RegionIdAllocator sequentialAllocator() {
+        final AtomicLong next = new AtomicLong(1);
+        return next::getAndIncrement;
+    }
+
+    @Test
+    public void singlePlayerProducesASingleRegionCoveringItsRadius() {
+        final RegionClusterer clusterer = new RegionClusterer(8, 4, 0.5);
+        final List<RegionClusterer.PlayerAnchor> players = List.of(new RegionClusterer.PlayerAnchor(PLAYER_A, 0, 0));
+
+        final List<RegionClusterer.Region> regions = clusterer.cluster(players, List.of(), sequentialAllocator());
+
+        assertEquals(1, regions.size());
+        assertEquals(Set.of(PLAYER_A), regions.get(0).members());
+    }
+
+    @Test
+    public void singlePlayersChunkSetExactlyMatchesExpectedSquareFootprint() {
+        final int radius = 8;
+        final RegionClusterer clusterer = new RegionClusterer(radius, 4, 0.5);
+        final List<RegionClusterer.PlayerAnchor> players = List.of(new RegionClusterer.PlayerAnchor(PLAYER_A, 10, -5));
+
+        final List<RegionClusterer.Region> regions = clusterer.cluster(players, List.of(), sequentialAllocator());
+
+        final Set<Long> expected = new HashSet<>();
+        for (int cx = 10 - radius; cx <= 10 + radius; cx++) {
+            for (int cz = -5 - radius; cz <= -5 + radius; cz++) {
+                expected.add(RegionClusterer.chunkKey(cx, cz));
+            }
+        }
+        assertEquals((2 * radius + 1) * (2 * radius + 1), expected.size());
+        assertEquals(expected, regions.get(0).chunks());
+    }
+
+    @Test
+    public void twoFarApartPlayersProduceTwoIndependentRegions() {
+        final RegionClusterer clusterer = new RegionClusterer(8, 4, 0.5);
+        final List<RegionClusterer.PlayerAnchor> players = List.of(
+            new RegionClusterer.PlayerAnchor(PLAYER_A, 0, 0),
+            new RegionClusterer.PlayerAnchor(PLAYER_B, 1000, 1000)
+        );
+
+        final List<RegionClusterer.Region> regions = clusterer.cluster(players, List.of(), sequentialAllocator());
+
+        assertEquals(2, regions.size());
+        assertNotEquals(regions.get(0).regionId(), regions.get(1).regionId());
+    }
+
+    @Test
+    public void twoNearbyPlayersMergeIntoOneRegion() {
+        final RegionClusterer clusterer = new RegionClusterer(8, 4, 0.5);
+        // merge threshold = 2*8+4 = 20; 10 chunks apart is well within range
+        final List<RegionClusterer.PlayerAnchor> players = List.of(
+            new RegionClusterer.PlayerAnchor(PLAYER_A, 0, 0),
+            new RegionClusterer.PlayerAnchor(PLAYER_B, 10, 0)
+        );
+
+        final List<RegionClusterer.Region> regions = clusterer.cluster(players, List.of(), sequentialAllocator());
+
+        assertEquals(1, regions.size());
+        assertEquals(Set.of(PLAYER_A, PLAYER_B), regions.get(0).members());
+    }
+
+    @Test
+    public void emptyPlayerListProducesNoRegions() {
+        final RegionClusterer clusterer = new RegionClusterer(8, 4, 0.5);
+
+        final List<RegionClusterer.Region> regions = clusterer.cluster(List.of(), List.of(), sequentialAllocator());
+
+        assertTrue(regions.isEmpty());
+    }
+
+    @Test
+    public void stickyIdIsReusedWhenOverlapMeetsThreshold() {
+        final RegionClusterer clusterer = new RegionClusterer(8, 4, 0.5);
+        final List<RegionClusterer.PlayerAnchor> firstTick = List.of(new RegionClusterer.PlayerAnchor(PLAYER_A, 0, 0));
+        final List<RegionClusterer.Region> firstRegions = clusterer.cluster(firstTick, List.of(), sequentialAllocator());
+        final long originalId = firstRegions.get(0).regionId();
+
+        // Small nudge: still overlaps the old footprint well above the 0.5 threshold.
+        final List<RegionClusterer.PlayerAnchor> secondTick = List.of(new RegionClusterer.PlayerAnchor(PLAYER_A, 2, 0));
+        final List<RegionClusterer.Region> secondRegions = clusterer.cluster(secondTick, firstRegions, sequentialAllocator());
+
+        assertEquals(1, secondRegions.size());
+        assertEquals(originalId, secondRegions.get(0).regionId());
+    }
+
+    @Test
+    public void stickyIdIsNotReusedWhenOverlapIsBelowThreshold() {
+        final RegionClusterer clusterer = new RegionClusterer(8, 4, 0.5);
+        // One shared allocator across both ticks: a fresh sequentialAllocator() per call would
+        // coincidentally restart from the same id and mask a real "no match found" bug as a false pass.
+        final RegionClusterer.RegionIdAllocator allocator = sequentialAllocator();
+        final List<RegionClusterer.PlayerAnchor> firstTick = List.of(new RegionClusterer.PlayerAnchor(PLAYER_A, 0, 0));
+        final List<RegionClusterer.Region> firstRegions = clusterer.cluster(firstTick, List.of(), allocator);
+        final long originalId = firstRegions.get(0).regionId();
+
+        // Teleported far away: zero overlap with the old footprint.
+        final List<RegionClusterer.PlayerAnchor> secondTick = List.of(new RegionClusterer.PlayerAnchor(PLAYER_A, 5000, 5000));
+        final List<RegionClusterer.Region> secondRegions = clusterer.cluster(secondTick, firstRegions, allocator);
+
+        assertEquals(1, secondRegions.size());
+        assertNotEquals(originalId, secondRegions.get(0).regionId());
+    }
+
+    @Test
+    public void splittingPlayersCausesExactlyOneSubRegionToInheritTheStickyId() {
+        final RegionClusterer clusterer = new RegionClusterer(8, 4, 0.5);
+        // One shared allocator across both ticks - see stickyIdIsNotReusedWhenOverlapIsBelowThreshold.
+        final RegionClusterer.RegionIdAllocator allocator = sequentialAllocator();
+        final List<RegionClusterer.PlayerAnchor> together = List.of(
+            new RegionClusterer.PlayerAnchor(PLAYER_A, 0, 0),
+            new RegionClusterer.PlayerAnchor(PLAYER_B, 5, 0)
+        );
+        final List<RegionClusterer.Region> mergedRegions = clusterer.cluster(together, List.of(), allocator);
+        assertEquals(1, mergedRegions.size());
+        final long mergedId = mergedRegions.get(0).regionId();
+
+        // A stays put (high overlap with the old merged footprint); B teleports far away (zero overlap).
+        final List<RegionClusterer.PlayerAnchor> apart = List.of(
+            new RegionClusterer.PlayerAnchor(PLAYER_A, 0, 0),
+            new RegionClusterer.PlayerAnchor(PLAYER_B, 5000, 5000)
+        );
+        final List<RegionClusterer.Region> splitRegions = clusterer.cluster(apart, mergedRegions, allocator);
+
+        assertEquals(2, splitRegions.size());
+        final long inheritedCount = splitRegions.stream().filter(r -> r.regionId() == mergedId).count();
+        assertEquals(1, inheritedCount, "exactly one split-off region must inherit the sticky id");
+        final RegionClusterer.Region regionForA = splitRegions.stream().filter(r -> r.members().contains(PLAYER_A)).findFirst().orElseThrow();
+        assertEquals(mergedId, regionForA.regionId(), "the player who stayed put should keep the sticky id");
+    }
+
+    @Test
+    public void convergingPlayersMergeAndTieBreakToTheSmallerOldRegionId() {
+        // A low sticky-overlap threshold (0.1) lets both old regions' modest, exactly-equal overlap
+        // with the merged footprint qualify as candidates below, so the tie-break rule actually fires
+        // instead of one candidate being filtered out for falling short of the threshold.
+        final RegionClusterer clusterer = new RegionClusterer(8, 4, 0.1);
+
+        // Symmetric around x=0 and far enough apart (distance 30 > merge threshold 20) to stay separate.
+        final List<RegionClusterer.PlayerAnchor> apart = List.of(
+            new RegionClusterer.PlayerAnchor(PLAYER_A, -15, 0),
+            new RegionClusterer.PlayerAnchor(PLAYER_B, 15, 0)
+        );
+        final List<RegionClusterer.Region> separateRegions = clusterer.cluster(apart, List.of(), sequentialAllocator());
+        assertEquals(2, separateRegions.size());
+        final long smallerId = Math.min(separateRegions.get(0).regionId(), separateRegions.get(1).regionId());
+
+        // Both players converge symmetrically around x=0 (distance 4 <= merge threshold 20): by the
+        // mirror symmetry of the setup, the merged footprint overlaps old A's and old B's footprints
+        // by the exact same fraction (4/17 each) - a genuine tie, not an approximation.
+        final List<RegionClusterer.PlayerAnchor> together = List.of(
+            new RegionClusterer.PlayerAnchor(PLAYER_A, -2, 0),
+            new RegionClusterer.PlayerAnchor(PLAYER_B, 2, 0)
+        );
+        final List<RegionClusterer.Region> mergedRegions = clusterer.cluster(together, separateRegions, sequentialAllocator());
+
+        assertEquals(1, mergedRegions.size());
+        assertEquals(smallerId, mergedRegions.get(0).regionId());
+    }
+
+    @Test
+    public void clusteringIsDeterministicForTheSameInputsAndAllocator() {
+        final RegionClusterer clusterer = new RegionClusterer(8, 4, 0.5);
+        final List<RegionClusterer.PlayerAnchor> players = List.of(
+            new RegionClusterer.PlayerAnchor(PLAYER_A, 0, 0),
+            new RegionClusterer.PlayerAnchor(PLAYER_B, 500, 500)
+        );
+
+        final List<RegionClusterer.Region> first = clusterer.cluster(players, List.of(), sequentialAllocator());
+        final List<RegionClusterer.Region> second = clusterer.cluster(players, List.of(), sequentialAllocator());
+
+        assertEquals(first, second);
+    }
+
+    @Test
+    public void manyPlayersClusterConsistentlyAcrossRepeatedRuns() {
+        final RegionClusterer clusterer = new RegionClusterer(4, 2, 0.5);
+        final List<RegionClusterer.PlayerAnchor> players = new ArrayList<>();
+        for (int i = 0; i < 20; i++) {
+            players.add(new RegionClusterer.PlayerAnchor(UUID.randomUUID(), (i % 5) * 100, (i / 5) * 100));
+        }
+
+        final List<RegionClusterer.Region> first = clusterer.cluster(players, List.of(), sequentialAllocator());
+        final List<RegionClusterer.Region> second = clusterer.cluster(players, List.of(), sequentialAllocator());
+
+        assertEquals(first, second);
+        // Every player must belong to exactly one region.
+        final long totalMembers = first.stream().mapToLong(r -> r.members().size()).sum();
+        assertEquals(players.size(), totalMembers);
+    }
+}
