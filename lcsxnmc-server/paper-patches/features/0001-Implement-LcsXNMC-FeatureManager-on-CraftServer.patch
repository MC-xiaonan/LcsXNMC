From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MC-xiaonan <2106104879@qq.com>
Date: Fri, 28 Aug 2026 18:25:13 +0800
Subject: [PATCH] Implement LcsXNMC FeatureManager on CraftServer


diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index e0d85e54d5b88a51ea0265ae2e1f1a2ef3fbe9eb..0b5549a334a58553e74b685a976ccc334a55fb5c 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -2950,4 +2950,13 @@ public final class CraftServer implements Server {
     public void allowPausing(final Plugin plugin, final boolean value) {
         this.console.addPluginAllowingSleep(plugin.getName(), value);
     }
+
+    // LcsXNMC start - FeatureManager API
+    private final dev.lcsxnmc.api.plugin.FeatureManager featureManager = new dev.lcsxnmc.server.plugin.LcsXNMCFeatureManager();
+
+    @Override
+    public dev.lcsxnmc.api.plugin.FeatureManager getFeatureManager() {
+        return this.featureManager;
+    }
+    // LcsXNMC end
 }
