diff --git a/src/main/java/dev/lcsxnmc/server/config/GlobalConfigManager.java b/src/main/java/dev/lcsxnmc/server/config/GlobalConfigManager.java
index 80a7035787bfeff99cd03ea71e17e3c7df747ce6..9dd96adcacec44811b4881b9c682525e89599939 100644
--- a/src/main/java/dev/lcsxnmc/server/config/GlobalConfigManager.java
+++ b/src/main/java/dev/lcsxnmc/server/config/GlobalConfigManager.java
@@ -34,6 +34,19 @@ public final class GlobalConfigManager {
         bindFields(yaml, configRoot, null, "");
     }
 
+    /**
+     * Binds a single already-constructed {@link GlobalConfigCategory}-annotated
+     * instance under {@code pathPrefix}, for callers that are not part of a
+     * config root's static field tree (e.g. a plugin-supplied config section).
+     *
+     * @param yaml       the backing yaml document
+     * @param instance   the category instance to bind
+     * @param pathPrefix the yaml path prefix, e.g. {@code "legacy-providers.acme."}
+     */
+    public static void bindInstance(YamlConfiguration yaml, Object instance, String pathPrefix) {
+        bindFields(yaml, instance.getClass(), instance, pathPrefix);
+    }
+
     private static void bindFields(YamlConfiguration yaml, Class<?> type, Object instance, String pathPrefix) {
         for (Field field : type.getDeclaredFields()) {
             if (field.isSynthetic() || (instance == null && !Modifier.isStatic(field.getModifiers()))) {
diff --git a/src/main/java/dev/lcsxnmc/server/plugin/LcsXNMCFeatureManager.java b/src/main/java/dev/lcsxnmc/server/plugin/LcsXNMCFeatureManager.java
index 54468cddd62c477bdf350bee580a91062adb4e93..e121d0957d05ed3182a7d986cdb638a8dc833cad 100644
--- a/src/main/java/dev/lcsxnmc/server/plugin/LcsXNMCFeatureManager.java
+++ b/src/main/java/dev/lcsxnmc/server/plugin/LcsXNMCFeatureManager.java
@@ -1,14 +1,18 @@
 package dev.lcsxnmc.server.plugin;
 
+import dev.lcsxnmc.api.legacy.LegacyBehaviorProvider;
 import dev.lcsxnmc.api.plugin.FeatureManager;
 import dev.lcsxnmc.server.LcsXNMCConfig;
 import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
 import java.util.stream.Collectors;
 import org.bukkit.Bukkit;
 import org.jetbrains.annotations.NotNull;
 
 public final class LcsXNMCFeatureManager implements FeatureManager {
 
+    private final Set<LegacyBehaviorProvider> providers = ConcurrentHashMap.newKeySet();
+
     private static final Set<String> KNOWN_FEATURES = Set.of(
         "debug-logging",
         "reduce-entity-attribute-allocations",
@@ -73,4 +77,25 @@ public final class LcsXNMCFeatureManager implements FeatureManager {
     public String getLcsXNMCVersion() {
         return Bukkit.getVersion();
     }
+
+    @Override
+    public void registerProvider(@NotNull LegacyBehaviorProvider provider) {
+        if (this.providers.add(provider)) {
+            Object configSection = provider.getConfigSection();
+            if (configSection != null) {
+                LcsXNMCConfig.bindExtra(configSection, "legacy-providers." + provider.getId() + ".");
+            }
+        }
+    }
+
+    @Override
+    public void unregisterProvider(@NotNull LegacyBehaviorProvider provider) {
+        this.providers.remove(provider);
+    }
+
+    @Override
+    @NotNull
+    public Set<LegacyBehaviorProvider> getRegisteredProviders() {
+        return Set.copyOf(this.providers);
+    }
 }
