From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MC-xiaonan <2106104879@qq.com>
Date: Sat, 29 Aug 2026 18:15:02 +0800
Subject: [PATCH] Region threading: wire region-threading config category +
 feature flag

- LcsXNMCConfig: new RegionThreadingCategory (enabled, disabled-worlds,
  min-region-radius-chunks, merge-distance-chunks, recluster-interval-ticks,
  sticky-overlap-threshold, max-regions). enabled defaults to false and stays
  false throughout Phase 4.4a; nothing reads this category's fields yet.
- LcsXNMCFeatureManager: register "region-threading" in KNOWN_FEATURES and
  wire isFeatureEnabled to LcsXNMCConfig.regionThreading.enabled.
- GlobalConfigManagerTest: prove the existing generic binder already round-trips
  List<String> fields (default write-back and populated-yaml override) with no
  changes to GlobalConfigManager itself, covering the plan's disabled-worlds
  List<String> round-trip requirement generically rather than via a new
  LcsXNMCConfig-specific test file (no prior category has one).

diff --git a/src/main/java/dev/lcsxnmc/server/LcsXNMCConfig.java b/src/main/java/dev/lcsxnmc/server/LcsXNMCConfig.java
index b4337a7043ccaa9ea9c8974a855b89df6cd3c1ab..8fb98fa0129b03e5789177a93a1f62990faaa3e1 100644
--- a/src/main/java/dev/lcsxnmc/server/LcsXNMCConfig.java
+++ b/src/main/java/dev/lcsxnmc/server/LcsXNMCConfig.java
@@ -5,6 +5,8 @@ import dev.lcsxnmc.server.config.annotation.GlobalConfig;
 import dev.lcsxnmc.server.config.annotation.GlobalConfigCategory;
 import java.io.File;
 import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
 import net.minecraft.server.MinecraftServer;
 import org.bukkit.configuration.file.YamlConfiguration;
 
@@ -136,6 +138,40 @@ public final class LcsXNMCConfig {
         public int targetSearchMinimumBatch = 32;
     }
 
+    public static RegionThreadingCategory regionThreading = new RegionThreadingCategory();
+
+    /**
+     * Player-centered region multithreading (Phase 4.4a). {@code enabled} stays
+     * {@code false} throughout Phase 4.4a's implementation - flipping it on is
+     * explicitly out of scope until the engine-internal region tick pipeline has
+     * been proven stable with plugins pinned to the global thread (Phase 4.4c).
+     * Not hot-reloadable once a server has actually started ticking regions: see
+     * {@link dev.lcsxnmc.server.regionizer.RegionClusterer} and friends.
+     */
+    @GlobalConfigCategory("region-threading")
+    public static final class RegionThreadingCategory {
+        @GlobalConfig("enabled")
+        public boolean enabled = false;
+
+        @GlobalConfig("disabled-worlds")
+        public List<String> disabledWorlds = new ArrayList<>();
+
+        @GlobalConfig("min-region-radius-chunks")
+        public int minRegionRadiusChunks = 8;
+
+        @GlobalConfig("merge-distance-chunks")
+        public int mergeDistanceChunks = 4;
+
+        @GlobalConfig("recluster-interval-ticks")
+        public int reclusterIntervalTicks = 20;
+
+        @GlobalConfig("sticky-overlap-threshold")
+        public double stickyOverlapThreshold = 0.5;
+
+        @GlobalConfig("max-regions")
+        public int maxRegions = 0;
+    }
+
     private static File configFile;
     private static YamlConfiguration config;
 
diff --git a/src/main/java/dev/lcsxnmc/server/plugin/LcsXNMCFeatureManager.java b/src/main/java/dev/lcsxnmc/server/plugin/LcsXNMCFeatureManager.java
index 66c6372098b928a2d05551ba322acbe78adca391..408f9d7aa48f9fe20b6fa9a0a3c0ac2d9c7b1cbc 100644
--- a/src/main/java/dev/lcsxnmc/server/plugin/LcsXNMCFeatureManager.java
+++ b/src/main/java/dev/lcsxnmc/server/plugin/LcsXNMCFeatureManager.java
@@ -32,7 +32,8 @@ public final class LcsXNMCFeatureManager implements FeatureManager {
         "copper-bulb-1gt-delay",
         "crafter-1gt-delay",
         "parallel-activation-range",
-        "parallel-target-search"
+        "parallel-target-search",
+        "region-threading"
     );
 
     @Override
@@ -58,6 +59,7 @@ public final class LcsXNMCFeatureManager implements FeatureManager {
             case "crafter-1gt-delay" -> LcsXNMCConfig.legacy.crafter1gtDelay;
             case "parallel-activation-range" -> LcsXNMCConfig.parallelism.parallelActivationRange;
             case "parallel-target-search" -> LcsXNMCConfig.parallelism.parallelTargetSearch;
+            case "region-threading" -> LcsXNMCConfig.regionThreading.enabled;
             default -> false;
         };
     }
diff --git a/src/test/java/dev/lcsxnmc/server/config/GlobalConfigManagerTest.java b/src/test/java/dev/lcsxnmc/server/config/GlobalConfigManagerTest.java
index f10b464f3a31123ffa950c0ebf1c0346507f9d0e..29d4146ae4ba0c2048783e3957bd236a9cf7aae0 100644
--- a/src/test/java/dev/lcsxnmc/server/config/GlobalConfigManagerTest.java
+++ b/src/test/java/dev/lcsxnmc/server/config/GlobalConfigManagerTest.java
@@ -2,6 +2,8 @@ package dev.lcsxnmc.server.config;
 
 import dev.lcsxnmc.server.config.annotation.GlobalConfig;
 import dev.lcsxnmc.server.config.annotation.GlobalConfigCategory;
+import java.util.ArrayList;
+import java.util.List;
 import org.bukkit.configuration.file.YamlConfiguration;
 import org.bukkit.support.environment.Normal;
 import org.junit.jupiter.api.BeforeEach;
@@ -25,6 +27,9 @@ public class GlobalConfigManagerTest {
 
             @GlobalConfig("worker-threads")
             public static int workerThreads = 4;
+
+            @GlobalConfig("disabled-worlds")
+            public static List<String> disabledWorlds = new ArrayList<>();
         }
 
         public static FeaturesCategory features = new FeaturesCategory();
@@ -38,6 +43,7 @@ public class GlobalConfigManagerTest {
         SampleConfig.configVersion = 1;
         SampleConfig.features.debugLogging = false;
         SampleConfig.features.workerThreads = 4;
+        SampleConfig.features.disabledWorlds = new ArrayList<>();
     }
 
     @Test
@@ -92,6 +98,34 @@ public class GlobalConfigManagerTest {
         assertEquals(8, SampleConfig.features.workerThreads);
     }
 
+    @Test
+    public void listOfStringFieldsRoundTripThroughYaml() throws Exception {
+        YamlConfiguration written = new YamlConfiguration();
+        SampleConfig.features.disabledWorlds = new ArrayList<>(List.of("world_the_end", "world_nether"));
+        GlobalConfigManager.load(written, SampleConfig.class);
+
+        assertEquals(List.of("world_the_end", "world_nether"), written.getStringList("features.disabled-worlds"));
+
+        String serialized = written.saveToString();
+        SampleConfig.features.disabledWorlds = new ArrayList<>();
+
+        YamlConfiguration reloaded = new YamlConfiguration();
+        reloaded.loadFromString(serialized);
+        GlobalConfigManager.load(reloaded, SampleConfig.class);
+
+        assertEquals(List.of("world_the_end", "world_nether"), SampleConfig.features.disabledWorlds);
+    }
+
+    @Test
+    public void missingListOfStringKeyWritesBackEmptyListDefault() {
+        YamlConfiguration yaml = new YamlConfiguration();
+
+        GlobalConfigManager.load(yaml, SampleConfig.class);
+
+        assertEquals(List.of(), SampleConfig.features.disabledWorlds);
+        assertEquals(List.of(), yaml.getStringList("features.disabled-worlds"));
+    }
+
     // Deliberately not @GlobalConfigCategory-annotated: bindInstance() takes an
     // explicit path prefix from the caller instead of relying on annotation-driven
     // category detection, since a plugin-supplied section isn't reachable from
