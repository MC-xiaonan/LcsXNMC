+    /**
+     * Picks the first available "nice" coding font, falling back to plain Monospaced
+     * so the GUI still renders correctly on machines without those fonts installed.
+     */
+    private static Font resolveMonospaceFont(final int style, final int size) {
+        String[] preferred = {"JetBrains Mono", "Cascadia Code", "Consolas", "Menlo", "DejaVu Sans Mono"};
+        java.util.Set<String> available = new java.util.HashSet<>(java.util.Arrays.asList(
+            java.awt.GraphicsEnvironment.getLocalGraphicsEnvironment().getAvailableFontFamilyNames()));
+        for (String name : preferred) {
+            if (available.contains(name)) {
+                return new Font(name, style, size);
+            }
+        }
+        return new Font(Font.MONOSPACED, style, size);
+    }
