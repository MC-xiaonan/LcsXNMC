+    /**
+     * Console chrome, part 1 of 2: a slim single-row toolbar (Clear / Copy) that sits directly above
+     * the log scroll pane, inside the "Log and chat" section. Visually it is the top bracket of the
+     * console: a hairline divider in BORDER_COLOR under the buttons, then the console's own
+     * BORDER_COLOR box begins immediately below. Deliberately uses the same PANEL_BACKGROUND as its
+     * parent panel so it reads as chrome framing the console rather than a separate block.
+     */
+    private JComponent buildConsoleToolbar(final javax.swing.JTextPane chatArea) {
+        JPanel toolbar = new JPanel(new java.awt.FlowLayout(java.awt.FlowLayout.LEFT, 6, 0));
+        toolbar.setBackground(PANEL_BACKGROUND);
+        toolbar.setBorder(new javax.swing.border.CompoundBorder(
+            new javax.swing.border.EmptyBorder(0, 0, 6, 0),
+            new javax.swing.border.MatteBorder(0, 0, 1, 0, BORDER_COLOR)));
+
+        final javax.swing.border.Border compactButtonBorder = new javax.swing.border.EmptyBorder(3, 12, 3, 12);
+
+        FlatButton clearButton = new FlatButton("Clear");
+        clearButton.setFont(UI_FONT);
+        clearButton.setBorder(compactButtonBorder);
+        clearButton.setToolTipText("Clear the console output");
+        clearButton.addActionListener(event -> {
+            javax.swing.text.StyledDocument document = chatArea.getStyledDocument();
+            try {
+                document.remove(0, document.getLength());
+            } catch (BadLocationException ignored) {
+            }
+        });
+
+        FlatButton copyButton = new FlatButton("Copy");
+        copyButton.setFont(UI_FONT);
+        copyButton.setBorder(compactButtonBorder);
+        copyButton.setToolTipText("Copy the console output to the clipboard");
+        copyButton.addActionListener(event -> {
+            java.awt.datatransfer.StringSelection selection = new java.awt.datatransfer.StringSelection(chatArea.getText());
+            java.awt.Toolkit.getDefaultToolkit().getSystemClipboard().setContents(selection, null);
+        });
+
+        toolbar.add(clearButton);
+        toolbar.add(copyButton);
+        return toolbar;
+    }
+
+    /**
+     * Console chrome, part 2 of 2: the slim status bar bracketing the entire GUI along the bottom
+     * edge. Mirrors the toolbar's hairline treatment - a single BORDER_COLOR line, this time on top,
+     * PANEL_BACKGROUND fill, UI_FONT text - so the toolbar (top bracket) and status bar (bottom
+     * bracket) read as one cohesive strip of chrome bookending the whole window, not two unrelated
+     * additions. Refreshes once per second via a javax.swing.Timer.
+     */
+    private JComponent buildStatusBar() {
+        JPanel statusBar = new JPanel(new BorderLayout());
+        statusBar.setBackground(PANEL_BACKGROUND);
+        statusBar.setBorder(new javax.swing.border.CompoundBorder(
+            new javax.swing.border.MatteBorder(1, 0, 0, 0, BORDER_COLOR), new javax.swing.border.EmptyBorder(4, 10, 4, 10)));
+
+        JPanel segments = new JPanel(new java.awt.FlowLayout(java.awt.FlowLayout.LEFT, 14, 0));
+        segments.setBackground(PANEL_BACKGROUND);
+
+        javax.swing.JLabel uptimeLabel = new javax.swing.JLabel("Uptime: 00:00:00");
+        uptimeLabel.setFont(UI_FONT);
+        uptimeLabel.setForeground(MUTED_TEXT_COLOR);
+
+        javax.swing.JLabel tpsLabel = new javax.swing.JLabel("TPS: --.-");
+        tpsLabel.setFont(UI_FONT);
+        tpsLabel.setForeground(MUTED_TEXT_COLOR);
+
+        javax.swing.JLabel playersLabel = new javax.swing.JLabel("Players: 0/0");
+        playersLabel.setFont(UI_FONT);
+        playersLabel.setForeground(MUTED_TEXT_COLOR);
+
+        segments.add(uptimeLabel);
+        segments.add(tpsLabel);
+        segments.add(playersLabel);
+        statusBar.add(segments, "West");
+
+        this.statusBarTimer = new Timer(1000, event -> this.updateStatusBar(uptimeLabel, tpsLabel, playersLabel));
+        this.statusBarTimer.setInitialDelay(0);
+        this.finalizers.add(this.statusBarTimer::stop);
+        this.updateStatusBar(uptimeLabel, tpsLabel, playersLabel);
+        return statusBar;
+    }
+
+    /**
+     * Refreshes the status bar's three segments once per second (see {@link #buildStatusBar()}).
+     * The TPS segment is color-coded using the existing JOIN_COLOR/WARN_COLOR/ERROR_COLOR palette
+     * (the same colors already used for join/leave and warn/error log lines) so a server operator can
+     * spot a struggling server at a glance without reading the exact number - a small, low-risk
+     * addition on top of the plain-text status line, using only colors already part of the theme.
+     */
+    private void updateStatusBar(final javax.swing.JLabel uptimeLabel, final javax.swing.JLabel tpsLabel, final javax.swing.JLabel playersLabel) {
+        long elapsedSeconds = (System.currentTimeMillis() - this.startTimeMillis) / 1000L;
+        long hours = elapsedSeconds / 3600L;
+        long minutes = (elapsedSeconds % 3600L) / 60L;
+        long seconds = elapsedSeconds % 60L;
+        uptimeLabel.setText(String.format("Uptime: %02d:%02d:%02d", hours, minutes, seconds));
+
+        double tps = Math.min(20.0, this.server.getTPS()[0]);
+        tpsLabel.setText(String.format("TPS: %.1f", tps));
+        if (tps >= 18.0) {
+            tpsLabel.setForeground(JOIN_COLOR);
+        } else if (tps >= 15.0) {
+            tpsLabel.setForeground(WARN_COLOR);
+        } else {
+            tpsLabel.setForeground(ERROR_COLOR);
+        }
+
+        playersLabel.setText("Players: " + this.server.getPlayerCount() + "/" + this.server.getMaxPlayers());
+    }
+
