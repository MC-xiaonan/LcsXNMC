+    // LcsXNMC start - region threading: two-phase cross-region entity handoff
+    @Override
+    protected boolean isCrossRegionMove(final int newSectionX, final int newSectionZ) {
+        final Thread current = Thread.currentThread();
+        if (!(current instanceof ca.spottedleaf.moonrise.common.util.RegionWorkerThread worker)) {
+            // the global tick thread owns every chunk not claimed by a real region (none are
+            // claimed yet - Phase 4.4a step 6), so it never needs the handoff protocol
+            return false;
+        }
+        final ca.spottedleaf.moonrise.common.util.TickRegion region = worker.getCurrentRegion();
+        return region == null || region.getWorld() != this.serverWorld || !region.ownsChunk(newSectionX, newSectionZ);
+    }
+
+    @Override
+    protected void enqueueCrossRegionArrival(final Entity entity, final int newSectionX, final int newSectionY, final int newSectionZ) {
+        // Unreachable in production today: isCrossRegionMove() above can only return true from a
+        // RegionWorkerThread, and nothing ever spawns one yet (Phase 4.4a step 6 introduces
+        // RegionizedWorldData, which resolves the target region and its arrival queue).
+        throw new UnsupportedOperationException("Cross-region entity handoff is not wired up until RegionizedWorldData exists (Phase 4.4a step 6)");
+    }
+    // LcsXNMC end - region threading
