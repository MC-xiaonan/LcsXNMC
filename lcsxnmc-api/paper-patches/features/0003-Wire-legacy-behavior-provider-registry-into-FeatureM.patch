From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MC-xiaonan <2106104879@qq.com>
Date: Fri, 25 Sep 2026 18:21:44 +0800
Subject: [PATCH] Wire legacy behavior provider registry into FeatureManager


diff --git a/src/main/java/dev/lcsxnmc/api/legacy/LegacyBehaviorEvent.java b/src/main/java/dev/lcsxnmc/api/legacy/LegacyBehaviorEvent.java
new file mode 100644
index 0000000000000000000000000000000000000000..19ed52bb8256dbe2bee88cdd2c28651c2491414a
--- /dev/null
+++ b/src/main/java/dev/lcsxnmc/api/legacy/LegacyBehaviorEvent.java
@@ -0,0 +1,89 @@
+package dev.lcsxnmc.api.legacy;
+
+import java.util.Collections;
+import java.util.Map;
+import org.bukkit.event.Cancellable;
+import org.bukkit.event.Event;
+import org.bukkit.event.HandlerList;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+
+/**
+ * Fired at a stable engine point where LcsXNMC's target Minecraft version
+ * changed or removed vanilla behavior. A "repair plugin" registers a normal
+ * {@code @EventHandler} listener for this event and calls
+ * {@link #setCancelled(boolean)} to signal "restore the legacy behavior
+ * instead" - the same convention Paper's own "Restore" patches already use
+ * for plugin-cancellable behavior gates.
+ * <p>
+ * A {@link LegacyBehaviorProvider} registered through
+ * {@link dev.lcsxnmc.api.plugin.FeatureManager#registerProvider(LegacyBehaviorProvider)}
+ * is a separate, optional capability declaration used for discovery (e.g.
+ * {@code /lcsxnmc legacy}); it does not participate in dispatching this event.
+ */
+public final class LegacyBehaviorEvent extends Event implements Cancellable {
+
+    private static final HandlerList HANDLERS = new HandlerList();
+
+    private final String key;
+    private final Map<String, Object> context;
+    private boolean cancelled;
+
+    public LegacyBehaviorEvent(@NotNull String key, @NotNull Map<String, Object> context) {
+        this.key = key;
+        this.context = Collections.unmodifiableMap(context);
+    }
+
+    /**
+     * The behavior key identifying which removed/changed vanilla behavior this
+     * event is asking about, e.g. {@code "item.example-legacy-stacking"}.
+     *
+     * @return the behavior key
+     */
+    @NotNull
+    public String getKey() {
+        return this.key;
+    }
+
+    /**
+     * Immutable context data describing the situation the behavior fired in
+     * (e.g. the block position, the item stack involved). Keys and value types
+     * are documented per behavior key, not by this event itself.
+     *
+     * @return the context map
+     */
+    @NotNull
+    public Map<String, Object> getContext() {
+        return this.context;
+    }
+
+    @Nullable
+    public Object getContext(@NotNull String contextKey) {
+        return this.context.get(contextKey);
+    }
+
+    @Override
+    public boolean isCancelled() {
+        return this.cancelled;
+    }
+
+    /**
+     * Cancelling this event means "restore the legacy behavior for this
+     * occurrence" - engine code checks {@link #isCancelled()} after firing.
+     */
+    @Override
+    public void setCancelled(boolean cancel) {
+        this.cancelled = cancel;
+    }
+
+    @NotNull
+    @Override
+    public HandlerList getHandlers() {
+        return HANDLERS;
+    }
+
+    @NotNull
+    public static HandlerList getHandlerList() {
+        return HANDLERS;
+    }
+}
diff --git a/src/main/java/dev/lcsxnmc/api/legacy/LegacyBehaviorProvider.java b/src/main/java/dev/lcsxnmc/api/legacy/LegacyBehaviorProvider.java
new file mode 100644
index 0000000000000000000000000000000000000000..612c80bdb9fac013fc277fe3ec81dc979a1be39f
--- /dev/null
+++ b/src/main/java/dev/lcsxnmc/api/legacy/LegacyBehaviorProvider.java
@@ -0,0 +1,60 @@
+package dev.lcsxnmc.api.legacy;
+
+import java.util.Set;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+
+/**
+ * A self-declared "repair plugin" capability descriptor: a statement of which
+ * {@link LegacyBehaviorEvent} keys a plugin restores, registered through
+ * {@link dev.lcsxnmc.api.plugin.FeatureManager#registerProvider(LegacyBehaviorProvider)}
+ * so server owners can discover what is installed (e.g. via
+ * {@code /lcsxnmc legacy}).
+ * <p>
+ * Registering a provider is purely for discoverability - it does not by
+ * itself do anything. Actually restoring a behavior still requires a normal
+ * {@code @EventHandler} listener on {@link LegacyBehaviorEvent} that calls
+ * {@code event.setCancelled(true)} for the keys it handles.
+ */
+public interface LegacyBehaviorProvider {
+
+    /**
+     * A short, stable, human-readable identifier for this provider, e.g.
+     * {@code "acme-legacy-fixes"}. Used as the config-section key when a
+     * provider supplies {@link #getConfigSection()}.
+     *
+     * @return the provider id
+     */
+    @NotNull
+    String getId();
+
+    /**
+     * A one-line description shown by {@code /lcsxnmc legacy}.
+     *
+     * @return the description
+     */
+    @NotNull
+    String getDescription();
+
+    /**
+     * The {@link LegacyBehaviorEvent#getKey()} values this provider restores.
+     *
+     * @return an immutable set of supported behavior keys
+     */
+    @NotNull
+    Set<String> getSupportedKeys();
+
+    /**
+     * An optional plain object this provider wants bound into
+     * {@code lcsxnmc.yml} under its own section (keyed by {@link #getId()}),
+     * using the same reflective {@code @GlobalConfig}-field binder LcsXNMC's
+     * own config uses. Returns {@code null} if the provider manages its own
+     * configuration instead.
+     *
+     * @return the config section instance, or null
+     */
+    @Nullable
+    default Object getConfigSection() {
+        return null;
+    }
+}
