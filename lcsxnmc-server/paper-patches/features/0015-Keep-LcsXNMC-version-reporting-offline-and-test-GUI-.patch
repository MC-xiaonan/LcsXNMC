+package dev.lcsxnmc;
+
+import java.awt.BorderLayout;
+import java.awt.Component;
+import java.awt.Container;
+import java.awt.event.ActionEvent;
+import java.lang.reflect.Constructor;
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.List;
+import javax.swing.JLabel;
+import javax.swing.SwingUtilities;
+import javax.swing.Timer;
+import net.minecraft.server.dedicated.DedicatedPlayerList;
+import net.minecraft.server.dedicated.DedicatedServer;
+import net.minecraft.server.gui.MinecraftServerGui;
+import org.bukkit.support.environment.Normal;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+@Normal
+class MinecraftServerGuiTest {
+
+    @Test
+    void statusBarSurvivesStartupAndTracksPlayers() throws Exception {
+        SwingUtilities.invokeAndWait(() -> {
+            final DedicatedServer server = mockServer();
+            when(server.getPlayerCount()).thenCallRealMethod();
+            final MinecraftServerGui gui = createGui(server);
+            try {
+                final BorderLayout layout = (BorderLayout) gui.getLayout();
+                for (final String region : List.of(BorderLayout.NORTH, BorderLayout.CENTER, BorderLayout.WEST)) {
+                    assertNotNull(layout.getLayoutComponent(region));
+                }
+                final Component statusBar = layout.getLayoutComponent(BorderLayout.SOUTH);
+                assertNotNull(statusBar, "The GUI constructor must not swallow a failed status bar build");
+                final JLabel playersLabel = labels((Container) statusBar).stream()
+                    .filter(label -> label.getText().startsWith("Players:"))
+                    .findFirst().orElseThrow();
+                final Timer timer = statusTimer(gui);
+                timer.start();
+                assertTrue(timer.isRunning());
+
+                assertEquals("Players: starting...", playersLabel.getText());
+                refresh(timer);
+                refresh(timer);
+                assertEquals("Players: starting...", playersLabel.getText());
+
+                final DedicatedPlayerList players = mock(DedicatedPlayerList.class);
+                when(server.getPlayerList()).thenReturn(players);
+                when(players.getPlayerCount()).thenReturn(0);
+                refresh(timer);
+                assertEquals("Players: 0/20", playersLabel.getText());
+
+                when(players.getPlayerCount()).thenReturn(7);
+                when(server.getMaxPlayers()).thenReturn(40);
+                refresh(timer);
+                assertEquals("Players: 7/40", playersLabel.getText());
+                verify(server, never()).getPlayerCount();
+            } finally {
+                gui.close();
+            }
+            assertFalse(statusTimer(gui).isRunning());
+        });
+    }
+
+    @Test
+    void statusBarSupportsAnAlreadyInitializedServer() throws Exception {
+        SwingUtilities.invokeAndWait(() -> {
+            final DedicatedServer server = mockServer();
+            final DedicatedPlayerList players = mock(DedicatedPlayerList.class);
+            when(server.getPlayerList()).thenReturn(players);
+            when(players.getPlayerCount()).thenReturn(3);
+            final MinecraftServerGui gui = createGui(server);
+            try {
+                final Component statusBar = ((BorderLayout) gui.getLayout()).getLayoutComponent(BorderLayout.SOUTH);
+                assertNotNull(statusBar);
+                assertTrue(labels((Container) statusBar).stream().anyMatch(label -> label.getText().equals("Players: 3/20")));
+            } finally {
+                gui.close();
+            }
+        });
+    }
+
+    @Test
+    void onboardingUsesLcsXnmcProject() throws Exception {
+        SwingUtilities.invokeAndWait(() -> {
+            final MinecraftServerGui gui = createGui(mockServer());
+            try {
+                final Component onboarding = ((BorderLayout) gui.getLayout()).getLayoutComponent(BorderLayout.NORTH);
+                assertNotNull(onboarding);
+                final List<String> text = labels((Container) onboarding).stream().map(JLabel::getText).toList();
+                assertTrue(text.stream().anyMatch(value -> value.contains("https://github.com/MC-xiaonan/LcsXNMC")));
+                assertFalse(text.stream().anyMatch(value -> value.contains("papermc.io")));
+            } finally {
+                gui.close();
+            }
+        });
+    }
+
+    private static DedicatedServer mockServer() {
+        final DedicatedServer server = mock(DedicatedServer.class);
+        when(server.getTPS()).thenReturn(new double[] {20.0, 20.0, 20.0});
+        when(server.getMaxPlayers()).thenReturn(20);
+        return server;
+    }
+
+    private static MinecraftServerGui createGui(final DedicatedServer server) {
+        return assertDoesNotThrow(() -> {
+            final Constructor<MinecraftServerGui> constructor = MinecraftServerGui.class.getDeclaredConstructor(DedicatedServer.class);
+            constructor.setAccessible(true);
+            return constructor.newInstance(server);
+        });
+    }
+
+    private static Timer statusTimer(final MinecraftServerGui gui) {
+        return assertDoesNotThrow(() -> {
+            final Field field = MinecraftServerGui.class.getDeclaredField("statusBarTimer");
+            field.setAccessible(true);
+            return (Timer) field.get(gui);
+        });
+    }
+
+    private static void refresh(final Timer timer) {
+        final ActionEvent event = new ActionEvent(timer, ActionEvent.ACTION_PERFORMED, "test");
+        for (final var listener : timer.getActionListeners()) {
+            listener.actionPerformed(event);
+        }
+    }
+
+    private static List<JLabel> labels(final Container container) {
+        final List<JLabel> labels = new ArrayList<>();
+        for (final Component child : container.getComponents()) {
+            if (child instanceof JLabel label) {
+                labels.add(label);
+            } else if (child instanceof Container nested) {
+                labels.addAll(labels(nested));
+            }
+        }
+        return labels;
+    }
+}
