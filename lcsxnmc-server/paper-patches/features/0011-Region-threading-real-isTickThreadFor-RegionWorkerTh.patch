index 0000000000000000000000000000000000000000..e85dc475ef295171218049e8e8bdd304818d4850
--- /dev/null
+++ b/src/main/java/ca/spottedleaf/moonrise/common/util/TickRegion.java
@@ -0,0 +1,54 @@
+// LcsXNMC start - region threading
+package ca.spottedleaf.moonrise.common.util;
+
+import it.unimi.dsi.fastutil.longs.LongOpenHashSet;
+import net.minecraft.world.level.Level;
+
+/**
+ * A single region's ownership snapshot for the duration of one tick: which world it belongs
+ * to and exactly which chunk columns it currently owns. Instances are frozen for the duration
+ * of a tick - region topology only ever changes at the reclustering barrier between ticks
+ * (Phase 4.4a step 6), never while a {@link RegionWorkerThread} is mid-tick.
+ *
+ * <p>Nothing constructs a real instance of this class yet (Phase 4.4a step 4): no code path
+ * ever creates a {@link RegionWorkerThread} in production, so every {@code TickThread.isTickThreadFor}
+ * check resolves exactly as it did before this class existed.</p>
+ */
+public final class TickRegion {
+
+    private final long regionId;
+    private final Level world;
+    private final LongOpenHashSet ownedChunks;
+
+    // step 6 (RegionizedWorldData/tick loop integration) populates and drains these; step 4 only
+    // needs a real place for a future TickRegion.tick() to keep them, unwired and untouched today
+    private final net.minecraft.world.level.entity.EntityTickList entityTickList = new net.minecraft.world.level.entity.EntityTickList();
+    private final io.papermc.paper.threadedregions.EntityScheduler.EntitySchedulerTickList entitySchedulerTickList = new io.papermc.paper.threadedregions.EntityScheduler.EntitySchedulerTickList();
+
+    public TickRegion(final long regionId, final Level world, final LongOpenHashSet ownedChunks) {
+        this.regionId = regionId;
+        this.world = world;
+        this.ownedChunks = ownedChunks;
+    }
+
+    public long getRegionId() {
+        return this.regionId;
+    }
+
+    public Level getWorld() {
+        return this.world;
+    }
+
+    public boolean ownsChunk(final int chunkX, final int chunkZ) {
+        return this.ownedChunks.contains(CoordinateUtils.getChunkKey(chunkX, chunkZ));
+    }
+
+    public net.minecraft.world.level.entity.EntityTickList getEntityTickList() {
+        return this.entityTickList;
+    }
+
+    public io.papermc.paper.threadedregions.EntityScheduler.EntitySchedulerTickList getEntitySchedulerTickList() {
+        return this.entitySchedulerTickList;
+    }
+}
+// LcsXNMC end - region threading
