From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MC-xiaonan <2106104879@qq.com>
Date: Fri, 25 Sep 2026 21:08:07 +0800
Subject: [PATCH] Rename getLcsXNMCVersion to getLcsXnmcVersion to match
 renamed API method


diff --git a/src/main/java/dev/lcsxnmc/server/command/LcsXNMCCommand.java b/src/main/java/dev/lcsxnmc/server/command/LcsXNMCCommand.java
index 3090dbaca6ac5cf5e514a3351ef2c31d8e307c66..8fd11f2e686ee35701e1a77c18f516c483038e16 100644
--- a/src/main/java/dev/lcsxnmc/server/command/LcsXNMCCommand.java
+++ b/src/main/java/dev/lcsxnmc/server/command/LcsXNMCCommand.java
@@ -34,7 +34,7 @@ public final class LcsXNMCCommand extends Command {
 
         final String sub = args.length == 0 ? "version" : args[0].toLowerCase(Locale.ROOT);
         switch (sub) {
-            case "version" -> sender.sendMessage("This server is running " + Bukkit.getServer().getFeatureManager().getLcsXNMCVersion());
+            case "version" -> sender.sendMessage("This server is running " + Bukkit.getServer().getFeatureManager().getLcsXnmcVersion());
             case "features" -> this.sendFeatures(sender);
             case "legacy" -> this.sendLegacyProviders(sender);
             case "reload" -> {
diff --git a/src/main/java/dev/lcsxnmc/server/plugin/LcsXNMCFeatureManager.java b/src/main/java/dev/lcsxnmc/server/plugin/LcsXNMCFeatureManager.java
index 408f9d7aa48f9fe20b6fa9a0a3c0ac2d9c7b1cbc..1aa121b5d936bca6f514547413b8e168514e3f68 100644
--- a/src/main/java/dev/lcsxnmc/server/plugin/LcsXNMCFeatureManager.java
+++ b/src/main/java/dev/lcsxnmc/server/plugin/LcsXNMCFeatureManager.java
@@ -78,7 +78,7 @@ public final class LcsXNMCFeatureManager implements FeatureManager {
 
     @Override
     @NotNull
-    public String getLcsXNMCVersion() {
+    public String getLcsXnmcVersion() {
         return Bukkit.getVersion();
     }
 
