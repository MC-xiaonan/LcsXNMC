From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MC-xiaonan <2106104879@qq.com>
Date: Fri, 25 Sep 2026 21:07:11 +0800
Subject: [PATCH] Fix checkstyle violations in legacy behavior provider
 framework and FeatureManager API

Migrate from org.jetbrains.annotations to JSpecify (@NullMarked packages),
add missing package-info.java files and Javadoc, fix annotation placement,
and rename getLcsXNMCVersion to getLcsXnmcVersion to satisfy the
abbreviation-length check.

diff --git a/src/main/java/dev/lcsxnmc/api/legacy/LegacyBehaviorEvent.java b/src/main/java/dev/lcsxnmc/api/legacy/LegacyBehaviorEvent.java
index 19ed52bb8256dbe2bee88cdd2c28651c2491414a..1124602fa644bf9ce4ca5da5918ebe3ece0bf9b1 100644
--- a/src/main/java/dev/lcsxnmc/api/legacy/LegacyBehaviorEvent.java
+++ b/src/main/java/dev/lcsxnmc/api/legacy/LegacyBehaviorEvent.java
@@ -5,8 +5,7 @@ import java.util.Map;
 import org.bukkit.event.Cancellable;
 import org.bukkit.event.Event;
 import org.bukkit.event.HandlerList;
-import org.jetbrains.annotations.NotNull;
-import org.jetbrains.annotations.Nullable;
+import org.jspecify.annotations.Nullable;
 
 /**
  * Fired at a stable engine point where LcsXNMC's target Minecraft version
@@ -29,7 +28,13 @@ public final class LegacyBehaviorEvent extends Event implements Cancellable {
     private final Map<String, Object> context;
     private boolean cancelled;
 
-    public LegacyBehaviorEvent(@NotNull String key, @NotNull Map<String, Object> context) {
+    /**
+     * Creates a new legacy behavior event.
+     *
+     * @param key     the behavior key
+     * @param context the context data describing the situation the behavior fired in
+     */
+    public LegacyBehaviorEvent(String key, Map<String, Object> context) {
         this.key = key;
         this.context = Collections.unmodifiableMap(context);
     }
@@ -40,7 +45,6 @@ public final class LegacyBehaviorEvent extends Event implements Cancellable {
      *
      * @return the behavior key
      */
-    @NotNull
     public String getKey() {
         return this.key;
     }
@@ -52,13 +56,17 @@ public final class LegacyBehaviorEvent extends Event implements Cancellable {
      *
      * @return the context map
      */
-    @NotNull
     public Map<String, Object> getContext() {
         return this.context;
     }
 
-    @Nullable
-    public Object getContext(@NotNull String contextKey) {
+    /**
+     * Looks up a single entry from {@link #getContext()}.
+     *
+     * @param contextKey the context map key
+     * @return the value, or null if absent
+     */
+    public @Nullable Object getContext(String contextKey) {
         return this.context.get(contextKey);
     }
 
@@ -76,13 +84,16 @@ public final class LegacyBehaviorEvent extends Event implements Cancellable {
         this.cancelled = cancel;
     }
 
-    @NotNull
     @Override
     public HandlerList getHandlers() {
         return HANDLERS;
     }
 
-    @NotNull
+    /**
+     * Gets the handler list for this event, as required by the Bukkit event system.
+     *
+     * @return the handler list
+     */
     public static HandlerList getHandlerList() {
         return HANDLERS;
     }
