diff --git a/src/main/java/dev/lcsxnmc/server/UpdateSuppressionException.java b/src/main/java/dev/lcsxnmc/server/UpdateSuppressionException.java
new file mode 100644
index 0000000000000000000000000000000000000000..220d8de7bb9664c32f1907333b78a206a7c057a0
--- /dev/null
+++ b/src/main/java/dev/lcsxnmc/server/UpdateSuppressionException.java
@@ -0,0 +1,16 @@
+package dev.lcsxnmc.server;
+
+/**
+ * Thrown from known crash-prone spots where a block/block-entity reference has gone
+ * stale because of a racing update within the same tick (e.g. the block changed between
+ * a lookup and a later cast). Caught by the tick/packet dispatch loops to skip just the
+ * one offending operation instead of taking down the whole server. Only ever thrown when
+ * {@code LcsXNMCConfig.fixes.updateSuppressionCrash} is enabled.
+ */
+public final class UpdateSuppressionException extends RuntimeException {
+
+    public UpdateSuppressionException(final String reason, final Throwable cause) {
+        // no stack trace capture - this is a recoverable control-flow signal, not a real crash
+        super(reason, cause, false, false);
+    }
+}
