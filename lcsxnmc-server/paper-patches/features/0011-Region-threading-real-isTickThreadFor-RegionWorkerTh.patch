@@ -0,0 +1,40 @@
+// LcsXNMC start - region threading
+package ca.spottedleaf.moonrise.common.util;
+
+import net.minecraft.world.level.Level;
+
+/**
+ * A tick thread that owns exactly one {@link TickRegion} at a time, as opposed to the single
+ * global tick thread which owns everything not claimed by a real region. Nothing spawns this
+ * thread yet (Phase 4.4a step 6 introduces the worker lifecycle) - it exists now so that
+ * {@link TickThread#isTickThreadFor} and the entity lookup's cross-region handoff protocol
+ * have a real type to check against, verified today by direct construction in unit tests
+ * rather than a running server.
+ */
+public final class RegionWorkerThread extends TickThread {
+
+    public final Level level;
+
+    private volatile TickRegion currentRegion;
+
+    public RegionWorkerThread(final ThreadGroup group, final Runnable run, final Level level, final long regionId) {
+        super(group, run, "Region Worker - " + WorldUtil.getWorldName(level) + " - " + regionId, false);
+        this.level = level;
+    }
+
+    /**
+     * The region this thread currently owns. Only ever written by this thread itself (from
+     * within its own tick loop); reads from other threads are for diagnostics only.
+     */
+    public TickRegion getCurrentRegion() {
+        return this.currentRegion;
+    }
+
+    /**
+     * Must only be called by this thread itself.
+     */
+    public void setCurrentRegion(final TickRegion region) {
+        this.currentRegion = region;
+    }
+}
+// LcsXNMC end - region threading
diff --git a/src/main/java/ca/spottedleaf/moonrise/common/util/TickRegion.java b/src/main/java/ca/spottedleaf/moonrise/common/util/TickRegion.java
