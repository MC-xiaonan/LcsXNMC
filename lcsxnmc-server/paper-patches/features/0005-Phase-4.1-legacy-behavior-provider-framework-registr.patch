@@ -149,6 +149,23 @@ public final class LcsXNMCConfig {
         dev.lcsxnmc.server.runtime.LcsXNMCComputeExecutors.reload();
     }
 
+    /**
+     * Binds a plugin-supplied {@code @GlobalConfigCategory} instance into
+     * {@code lcsxnmc.yml} under {@code pathPrefix}, reusing the same reflective
+     * binder as this class's own fields. A no-op if the config hasn't been
+     * loaded yet (e.g. a provider registers before {@link #init(File)} runs).
+     *
+     * @param instance   the config section instance to bind
+     * @param pathPrefix the yaml path prefix to bind it under
+     */
+    public static void bindExtra(Object instance, String pathPrefix) {
+        if (config == null) {
+            return;
+        }
+        GlobalConfigManager.bindInstance(config, instance, pathPrefix);
+        save();
+    }
+
     private static void save() {
         try {
             config.save(configFile);
